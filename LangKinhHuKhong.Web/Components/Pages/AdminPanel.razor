    // Verify the new record is actually visible after upload, rather than showing a false success.
    private async Task<bool> ConfirmEpisodeVisible(string storyId, string episodeId, int episodeNum = 0)
    {
        for (var attempt=0; attempt<4; attempt++)
        {
            if (storyId!=activeStoryId) return false;
            if (await LoadEpisodes(false) && episodeRows.Any(ep =>
                (!string.IsNullOrWhiteSpace(episodeId) && Ui.Str(ep,"id")==episodeId) ||
                (episodeNum > 0 && Ui.Num(ep,"episode_number")==episodeNum)))
                return true;
            if (attempt<3) await Task.Delay(400);
        }
        return false;
    }

    // Check server + Cloudflare R2 status before reporting success or failure to the user.
    // If a reverse proxy or browser connection times out on a 30-120 minute MP3 while FFmpeg/R2
    // is still running on the server, this waits until the server finishes and verifies R2 objects.
    private async Task<(bool Verified, string EpisodeId, string StorageMode, string Detail, string ServerError)> VerifyCloudflareAndSyncEpisodeAsync(
        string storyId, int targetNumber, string episodeId)
    {
        var lastErr = "";
        for (var poll = 0; poll < 180; poll++)
        {
            if (storyId != activeStoryId) return (false, "", "", "", "");
            try
            {
                var url = $"/admin/stories/{Uri.EscapeDataString(storyId)}/episodes/upload-status?episodeNumber={targetNumber}" +
                          (string.IsNullOrWhiteSpace(episodeId) ? "" : $"&episodeId={Uri.EscapeDataString(episodeId)}");
                var status = await Api.Get(url);
                var inProgress = status.TryGetProperty("inProgress", out var ip) && ip.ValueKind == JsonValueKind.True;
                if (inProgress)
                {
                    var stage = Ui.Str(status, "stage");
                    var elapsed = Ui.Num(status, "elapsedSeconds");
                    uploadStatus = $"{(stage != "" ? stage : "Đang xử lý file MP3 dài trên máy chủ...")} ({elapsed}s) — Vui lòng không tắt trang...";
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(2000);
                    continue;
                }

                var exists = status.TryGetProperty("exists", out var ex) && ex.ValueKind == JsonValueKind.True;
                var r2Verified = status.TryGetProperty("r2Verified", out var rv) && rv.ValueKind == JsonValueKind.True;
                var resolvedId = Ui.Str(status, "id");
                if (resolvedId == "") resolvedId = episodeId;
                var storageMode = Ui.Str(status, "storage");
                var detail = Ui.Str(status, "detail");
                var srvErr = Ui.Str(status, "lastError");
                if (srvErr != "") lastErr = srvErr;

                if (exists && r2Verified)
                {
                    uploadStatus = "Đã xác nhận file trên Cloudflare R2. Đang đồng bộ danh sách tập...";
                    await InvokeAsync(StateHasChanged);
                    await ConfirmEpisodeVisible(storyId, resolvedId, targetNumber);
                    return (true, resolvedId, storageMode, detail, "");
                }

                if (!exists && lastErr != "")
                    return (false, "", storageMode, detail, lastErr);
            }
            catch
            {
                // Transient network blip during long upload check; retry shortly.
            }

            if (poll >= 2) break;
            await Task.Delay(1200);
        }
        return (false, "", "", "", lastErr);
    }

