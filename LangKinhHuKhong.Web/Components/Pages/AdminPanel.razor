    private async Task UploadAudio()
    {
        if (busy) return;
        if (activeStoryId=="") { Notify("Chưa chọn bộ truyện.",true); return; }
        var storyId=activeStoryId;
        var targetNumber=episodeNumber;
        busy=true;
        uploadingAudio=true;
        uploadStatus="Đang tải MP3 và xử lý Preview / HLS trên máy chủ...";
        await InvokeAsync(StateHasChanged);
        try
        {
            // This request returns after the server finishes FFmpeg, R2 and SQLite INSERT.
            var created=await Api.Upload(storyId,episodeTitle,targetNumber);
            var episodeId=Ui.Str(created,"id");
            uploadStatus="Đang kiểm tra trạng thái MP3 & HLS trên Cloudflare R2...";
            await InvokeAsync(StateHasChanged);

            var check = await VerifyCloudflareAndSyncEpisodeAsync(storyId, targetNumber, episodeId);
            episodeNumber = Math.Max(episodeNumber, targetNumber + 1);
            episodeTitle = "";
            if (check.Verified)
            {
                lastUploadedEpisodeId = check.EpisodeId != "" ? check.EpisodeId : episodeId;
                try { stats=await Api.Get("/admin/stats"); storageInfo=await Api.Get("/admin/storage"); } catch { }
                Notify($"Upload hoàn tất! Đã kiểm tra trạng thái {check.StorageMode} ({check.Detail}) và hiển thị tập {targetNumber} trong danh sách.");
            }
            else if (await ConfirmEpisodeVisible(storyId, episodeId, targetNumber))
            {
                lastUploadedEpisodeId = episodeId;
                try { stats=await Api.Get("/admin/stats"); } catch { }
                Notify("Upload hoàn tất. Tập mới đã xuất hiện trong danh sách, Preview và HLS Premium đã sẵn sàng.");
            }
            else
            {
                Notify("Upload đã được máy chủ xác nhận, nhưng chưa thể đồng bộ danh sách. " +
                       "Nhấn 'Làm mới danh sách' để kiểm tra. Không upload lại ngay để tránh trùng số tập.",true);
            }
        }
        catch(Exception e)
        {
            // Before reporting an error to the user (especially on 30+ minute MP3s where proxy/connection
            // may time out while FFmpeg/R2 is still finishing), check server & Cloudflare R2 status first.
            var clientPrecheckError = e.Message.Contains("Hãy chọn file MP3", StringComparison.OrdinalIgnoreCase) ||
                                      e.Message.Contains("tối đa 250MB", StringComparison.OrdinalIgnoreCase) ||
                                      e.Message.Contains("không hợp lệ", StringComparison.OrdinalIgnoreCase);
            if (!clientPrecheckError)
            {
                uploadStatus="Kết nối gián đoạn hoặc tập dài đang xử lý. Đang kiểm tra trạng thái trên Cloudflare R2...";
                await InvokeAsync(StateHasChanged);
                var check = await VerifyCloudflareAndSyncEpisodeAsync(storyId, targetNumber, "");
                if (check.Verified)
                {
                    episodeNumber = Math.Max(episodeNumber, targetNumber + 1);
                    episodeTitle = "";
                    lastUploadedEpisodeId = check.EpisodeId;
                    try { stats=await Api.Get("/admin/stats"); storageInfo=await Api.Get("/admin/storage"); } catch { }
                    Notify($"Upload hoàn tất! Tập {targetNumber} đã được xác nhận đầy đủ trên {check.StorageMode} ({check.Detail}) và đồng bộ vào danh sách.");
                    return;
                }
                if (!string.IsNullOrWhiteSpace(check.ServerError))
                {
                    Notify("Upload MP3 thất bại (đã kiểm tra Cloudflare R2): " + check.ServerError, true);
                    return;
                }
            }
            Notify("Upload MP3 thất bại: "+e.Message,true);
        }
        finally
        {
            busy=false;
            uploadingAudio=false;
            uploadStatus="";
            await InvokeAsync(StateHasChanged);
        }
    }
