        <div class="table-scroll overflow-x-auto"><table><thead><tr><th>Mã hồ sơ</th><th>Thành viên</th><th>Nguồn</th><th>Giá</th><th>Trạng thái</th><th>Thời gian</th><th></th></tr></thead><tbody>
        @foreach(var o in orderRows)
        {
            var granted=Ui.Str(o,"order_type")=="AdminGrant";
            <tr><td class="mono">@Ui.Str(o,"code")</td><td>@Ui.Str(o,"username")</td><td><span class="pill @(granted ? "premium-admin-badge" : "")">@(granted ? "Admin cấp" : "User tự mua")</span>@if(granted){<small class="order-subtitle">@Ui.Str(o,"grant_reason")</small>}</td><td>@(granted ? "0đ (cấp quyền)" : Ui.Money(Ui.Num(o,"amount_vnd")))</td><td>@(granted ? "Đã cấp / gia hạn" : Ui.Str(o,"status"))</td><td>@Ui.Date(Ui.Str(o,"created_at"))</td><td><button class="text-link" @onclick="() => SelectOrder(o)">@(granted ? "Chi tiết" : "Đối soát")</button></td></tr>
        }
        </tbody></table></div></div>
        @if(activeOrderId!="")
        {
            <div class="panel top-margin form">
                <h2>Hồ sơ @activeOrderCode</h2>
                @if(activeOrderType=="AdminGrant")
                {
                    <div class="premium-reason"><b>Admin cấp / gia hạn Premium — không phát sinh thanh toán</b><p>@activeOrderReason</p></div>
                    <div class="meta-line"><span>Số tháng cộng thêm</span><b>@activeOrderMonths tháng</b></div>
                    <div class="meta-line"><span>Ngày hết hạn mới</span><b>@Ui.Date(activeOrderEnd)</b></div>
                    <div class="meta-line"><span>Admin thực hiện</span><b>@activeOrderActor</b></div>
