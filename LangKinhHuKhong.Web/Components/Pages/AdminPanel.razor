    private async Task SaveNotepadFile()
    {
        if (busy || savingNotepad) return;
        if (notepadDriveOnlyMode)
        {
            busy = true;
            savingNotepad = true;
            await InvokeAsync(StateHasChanged);
            try
            {
                var fname = string.IsNullOrWhiteSpace(notepadFileName) ? "ban-thao" + notepadExtension : notepadFileName.Trim();
                if (!fname.EndsWith(".txt", StringComparison.OrdinalIgnoreCase) && !fname.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
                    fname += notepadExtension;
                var savedDrive = await Api.SaveDriveNotepadFile(notepadDriveFileId, driveCurrentFolderId, fname, notepadTitle);
                notepadDriveFileId = Ui.Str(savedDrive, "id");
                notepadFileName = Ui.Str(savedDrive, "name");
                notepadSizeBytes = Ui.Num(savedDrive, "sizeBytes");
                notepadUpdatedAt = Ui.Str(savedDrive, "modifiedTime");
                if (showDriveExplorer) await BrowseDriveFolder(driveCurrentFolderId, driveCurrentFolderName);
                allTextFileRows = Ui.Array(await Api.Get("/admin/texts"));
                Notify($"Đã lưu file '{notepadFileName}' trực tiếp lên Google Drive.");
            }
            catch (Exception e)
            {
                Notify("Lưu file lên Google Drive thất bại: " + e.Message, true);
            }
            finally
            {
                busy = false;
                savingNotepad = false;
                await InvokeAsync(StateHasChanged);
            }
            return;
        }
        if (string.IsNullOrWhiteSpace(notepadStoryId))
        {
            Notify("Hãy chọn bộ truyện cho file chữ.", true);
            return;
        }
        var target = NormalizeTarget(notepadStorageTarget);
        if ((target == "drive" || target == "both") && !Ui.Bool(gdriveStatus, "connected"))
        {
            Notify("Chưa kết nối tài khoản Google Drive. Hãy kết nối Google Drive trước hoặc chuyển luồng sang 'Chỉ lưu trên VPS'.", true);
            return;
        }
        busy = true;
        savingNotepad = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var isNew = string.IsNullOrWhiteSpace(notepadFileId);
            var saved = await Api.SaveNotepadFile(notepadFileId, notepadStoryId, notepadTitle, notepadFileName, notepadExtension, target);
            notepadFileId = Ui.Str(saved, "id");
            notepadStoryId = Ui.Str(saved, "storyId") != "" ? Ui.Str(saved, "storyId") : Ui.Str(saved, "story_id");
            notepadTitle = Ui.Str(saved, "title");
            notepadFileName = Ui.Str(saved, "fileName") != "" ? Ui.Str(saved, "fileName") : Ui.Str(saved, "file_name");
            notepadExtension = Ui.Str(saved, "extension");
