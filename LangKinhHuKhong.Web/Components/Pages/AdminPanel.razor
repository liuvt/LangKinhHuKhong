    private async Task SavePrice(){try{await Api.Put("/admin/plans/premium",new{priceVnd=premiumPrice});Notify("Đã cập nhật giá Premium. Đơn cũ giữ nguyên giá.");}catch(Exception e){Notify(e.Message,true);}}
