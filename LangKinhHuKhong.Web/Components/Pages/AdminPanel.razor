                        <div class="table-actions"><button class="btn btn-primary" @onclick="ConfirmOrder" disabled="@busy">Xác nhận đã nhận tiền</button></div>
                        <label>Lý do từ chối<input @bind="rejectReason" maxlength="300" /></label>
                        <button class="btn btn-outline" @onclick="RejectOrder" disabled="@busy">Từ chối đơn hàng</button>
                    }
                    else { <p class="hint">Đơn đã xử lý, không thể xác nhận lại.</p> }
                }
                <button class="btn btn-outline" @onclick='() => activeOrderId = ""'>Đóng chi tiết</button>
            </div>
        }
    }
    else if(tab=="banks")
    {
        <BankAccountsPanel />
    }
    else if(tab=="settings")
    {
        <div class="panel form rounded-2xl" style="max-width:600px"><h2>Giá gói Premium</h2><label>Giá theo VNĐ / tháng<input type="number" @bind="premiumPrice" min="0" max="100000000" /></label><button class="btn btn-primary" @onclick="SavePrice">Cập nhật giá</button><p class="hint">Đơn đã tạo giữ nguyên giá tại thời điểm tạo QR. Tài khoản nhận tiền cấu hình ở mục Tài khoản QR.</p></div>
    }
    else if(tab=="audit")
    {
        <div class="panel rounded-2xl"><h2>Nhật ký quản trị gần đây</h2><div class="table-scroll overflow-x-auto"><table><thead><tr><th>Ngày</th><th>Hành động</th><th>Đối tượng</th><th>Thông tin</th></tr></thead><tbody>@foreach(var log in auditRows){<tr><td>@Ui.Date(Ui.Str(log,"created_at"))</td><td class="mono">@Ui.Str(log,"action")</td><td class="mono">@Ui.Str(log,"subject_id")</td><td>@Ui.Str(log,"details")</td></tr>}</tbody></table></div></div>
    }
</section>

@code {
    private string activeOrderBank="",activeOrderAccountNumber="",activeOrderAccountName="";
    private string activeOrderType="",activeOrderReason="",activeOrderEnd="",activeOrderActor="";
    private int activeOrderMonths=0;
    private string tab="stories",message="",activeStoryId="",editingStoryId="",episodeTitle="",editEpisodeId="",editEpisodeTitle="",editEpisodeStatus="Published",deleteEpisodeId="",deleteEpisodeTitle="",editUserId="",editUsername="",editFullName="",editPhone="",editAddress="",editStatus="Active",grantReason="",activeOrderId="",activeOrderCode="",activeOrderStatus="",bankReference="",rejectReason="";
    private int episodeNumber=1,editEpisodeNumber=1,grantMonths=1,premiumPrice=100000,activeOrderAmount=0;
    private bool loading=true,busy=false,failed=false;
    private bool uploadingAudio=false,refreshingEpisodes=false,uploadingTexts=false,notepadOpen=false,savingNotepad=false;
    private bool syncingDrive=false,showDriveExplorer=false,showGdriveConfig=false,notepadDriveOnlyMode=false;
    private string uploadStatus="",lastUploadedEpisodeId="",uploadingTarget="vps";
    private string textFileTitle="",previewTextId="",previewTextFileName="",previewTextContent="";
    private string notepadFilterStoryId="",notepadFilterStorageTarget="",notepadSearch="",notepadUploadStoryId="",notepadUploadTitle="";
    private string notepadFileId="",notepadDriveFileId="",notepadStoryId="",notepadStorageTarget="vps",notepadTitle="",notepadFileName="",notepadExtension=".txt",notepadUpdatedAt="",deleteNotepadFileId="",deleteNotepadFileName="",deleteNotepadStorageTarget="vps";
    private string gdriveClientIdInput="",gdriveClientSecretInput="",gdriveRootFolderInput="LangKinhHuKhong-BanThao";
    private string driveCurrentFolderId="",driveCurrentFolderName="",driveNewFolderName="";
    private int previewTextSize=0,notepadSizeBytes=0;
    private bool previewTextTruncated=false;
    private JsonElement stats,storageInfo,gdriveStatus;
    private JsonElement[] storyRows=[],episodeRows=[],textFileRows=[],allTextFileRows=[],driveItems=[],userRows=[],orderRows=[],auditRows=[],genreRows=[],reviewRows=[];
    private JsonElement[] FilteredAllTextFiles => allTextFileRows.Where(tf =>
        (string.IsNullOrWhiteSpace(notepadFilterStoryId) || Ui.Str(tf, "story_id") == notepadFilterStoryId) &&
        (string.IsNullOrWhiteSpace(notepadFilterStorageTarget) || NormalizeTarget(Ui.Str(tf, "storage_target")) == notepadFilterStorageTarget) &&
        (string.IsNullOrWhiteSpace(notepadSearch) ||
         Ui.Str(tf, "title").Contains(notepadSearch.Trim(), StringComparison.OrdinalIgnoreCase) ||
         Ui.Str(tf, "file_name").Contains(notepadSearch.Trim(), StringComparison.OrdinalIgnoreCase) ||
         Ui.Str(tf, "story_title").Contains(notepadSearch.Trim(), StringComparison.OrdinalIgnoreCase))).ToArray();
    private static string NormalizeTarget(string? raw)
    {
        var t = (raw ?? "").Trim().ToLowerInvariant();
        if (t == "both") return "both";
        if (t == "drive" || t == "gdrive") return "drive";
        return "vps";
    }
    private static string TargetBadgeClass(string target) => target switch
    {
        "both" => "storage-r2",
        "drive" => "storage-r2",
        _ => "storage-local"
    };
    private static string TargetBadgeText(string target) => target switch
    {
        "both" => "⇄ VPS + Drive (Dự phòng)",
        "drive" => "☁ Chỉ Google Drive",
        _ => "💾 Chỉ trên VPS"
    };
    private static string TargetDisplayLabel(string target) => target switch
    {
        "both" => "cả VPS & Google Drive (Dự phòng)",
        "drive" => "Google Drive",
        _ => "ổ đĩa VPS"
    };
    private string newGenreName="",editGenreSlug="",editGenreName="";
    private bool editGenreActive=true;
    private StoryForm story=new();
    private JsonElement ActiveStory => storyRows.FirstOrDefault(x=>Ui.Str(x,"id")==activeStoryId);
    private string ActiveStoryPrefix => Ui.Str(ActiveStory,"storage_prefix");
    private string ActiveCoverUrl => string.IsNullOrEmpty(Ui.Str(ActiveStory,"cover_image_url"))
        ? "" : Ui.Str(ActiveStory,"cover_image_url") + "?v=" + Uri.EscapeDataString(Ui.Str(ActiveStory,"updated_at"));
    
    protected override async Task OnInitializedAsync()
    {
        CheckQueryFlags();
        await Reload();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && loading)
        {
            await Reload();
            StateHasChanged();
        }
    }
    private void CheckQueryFlags()
    {
        try
        {
            var uri = new Uri(Navigation.Uri);
            if (string.IsNullOrWhiteSpace(uri.Query)) return;
            var parts = uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
            foreach (var p in parts)
            {
                var kv = p.Split('=', 2);
                if (kv.Length == 0) continue;
                var k = Uri.UnescapeDataString(kv[0]);
                var v = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : "";
                if (k == "tab" && v == "notepad") tab = "notepad";
                else if (k == "gdrive" && v == "connected")
                {
                    tab = "notepad";
                    Notify("Đã kết nối thành công với Google Drive! Bạn có thể bấm 'Đẩy toàn bộ VPS → Drive' hoặc quản lý file trực tiếp.");
                }
                else if (k == "gdrive_error" && !string.IsNullOrWhiteSpace(v))
                {
                    tab = "notepad";
                    Notify("Lỗi kết nối Google Drive: " + v, true);
                }
            }
        }
        catch { }
    }
    private async Task Reload()
    {
        loading=true;
        try
        {
            await using var db = await Database.OpenAsync();
            var statRow = await db.FirstAsync(@"SELECT
                (SELECT COUNT(*) FROM users WHERE status='Active') AS users,
                (SELECT COUNT(*) FROM stories) AS stories,
                (SELECT COUNT(*) FROM episodes) AS episodes,
                (SELECT COUNT(*) FROM orders WHERE status IN ('Pending','Reviewing')) AS pending,
                (SELECT COALESCE(SUM(amount_vnd),0) FROM payments) AS income,
                (SELECT COUNT(DISTINCT user_id) FROM subscriptions WHERE ends_at>@now) AS premium",
                ("@now", Helpers.Now()));
            stats = JsonSerializer.SerializeToElement(new
            {
                users = statRow?.N("users") ?? 0,
                stories = statRow?.N("stories") ?? 0,
                episodes = statRow?.N("episodes") ?? 0,
                pending = statRow?.N("pending") ?? 0,
                income = statRow?["income"] ?? 0,
                premium = statRow?.N("premium") ?? 0
            });
            var cleanupPending = Convert.ToInt32(await db.ValueAsync("SELECT COUNT(*) FROM storage_cleanup"));
            storageInfo = JsonSerializer.SerializeToElement(new
            {
                mode = AudioStorage.Mode,
                bucket = AudioStorage.Bucket,
                isR2 = AudioStorage.IsR2,
                cleanupPending
            });
            storyRows = (await db.ListAsync(@"
                WITH g_keys AS (
                    SELECT sg.story_id, group_concat(g.slug,'|') AS keys
                    FROM story_genres sg JOIN genres g ON g.slug=sg.genre_slug GROUP BY sg.story_id
                ),
                ep_cnt AS (SELECT story_id, COUNT(*) AS cnt FROM episodes GROUP BY story_id),
                tf_cnt AS (SELECT story_id, COUNT(*) AS cnt FROM story_text_files GROUP BY story_id)
                SELECT stories.*,
                CASE WHEN stories.cover_file<>'' THEN '/api/stories/' || stories.id || '/cover' ELSE stories.cover_url END AS cover_image_url,
                COALESCE(gk.keys,'') AS genre_keys,
                COALESCE(ec.cnt,0) AS episode_count,
                COALESCE(tc.cnt,0) AS text_count
                FROM stories
                LEFT JOIN g_keys gk ON gk.story_id=stories.id
                LEFT JOIN ep_cnt ec ON ec.story_id=stories.id
                LEFT JOIN tf_cnt tc ON tc.story_id=stories.id
                ORDER BY stories.updated_at DESC LIMIT 300")).Select(x => JsonSerializer.SerializeToElement(x)).ToArray();
            genreRows = (await db.ListAsync("SELECT slug,name,is_active,sort_order FROM genres ORDER BY sort_order,name"))
                .Select(x => JsonSerializer.SerializeToElement(x)).ToArray();
            var p = await db.FirstAsync("SELECT * FROM subscription_plans LIMIT 1");
            if (p is not null) premiumPrice = p.N("price_vnd");
            gdriveStatus = JsonSerializer.SerializeToElement(GoogleDrive.GetStatus());
            gdriveRootFolderInput = Ui.Str(gdriveStatus, "rootFolderName") != "" ? Ui.Str(gdriveStatus, "rootFolderName") : "LangKinhHuKhong-BanThao";

            allTextFileRows = (await db.ListAsync(@"SELECT tf.id,tf.story_id,tf.title,tf.file_name,tf.extension,tf.size_bytes,tf.drive_file_id,
                CASE
                  WHEN tf.stored_name<>'' AND tf.drive_file_id<>'' THEN 'both'
                  WHEN tf.storage_target='drive' OR (tf.stored_name='' AND tf.drive_file_id<>'') THEN 'drive'
                  ELSE 'vps'
                END AS storage_target,
                tf.created_at,
                CASE WHEN tf.updated_at<>'' THEN tf.updated_at ELSE tf.created_at END AS updated_at,
                s.title AS story_title, s.slug AS story_slug
                FROM story_text_files tf JOIN stories s ON s.id=tf.story_id
                ORDER BY COALESCE(NULLIF(tf.updated_at,''), tf.created_at) DESC, tf.file_name ASC LIMIT 500"))
                .Select(x => JsonSerializer.SerializeToElement(x)).ToArray();
            reviewRows = (await db.ListAsync(@"SELECT r.id,r.stars,r.body,r.status,r.updated_at,
                u.username,s.title AS story_title FROM story_reviews r
                JOIN users u ON u.id=r.user_id JOIN stories s ON s.id=r.story_id
                ORDER BY r.updated_at DESC LIMIT 200")).Select(x => JsonSerializer.SerializeToElement(x)).ToArray();
            userRows = (await db.ListAsync(@"
                WITH sub_max AS (SELECT user_id, MAX(ends_at) AS max_end FROM subscriptions GROUP BY user_id)
                SELECT u.id,u.username,u.full_name,u.phone,u.address,u.role,u.status,u.created_at,
                sm.max_end AS premiumUntil
                FROM users u LEFT JOIN sub_max sm ON sm.user_id=u.id
                ORDER BY u.created_at DESC LIMIT 200")).Select(x => JsonSerializer.SerializeToElement(x)).ToArray();
            await db.ExecAsync("UPDATE orders SET status='Expired' WHERE order_type='Purchase' AND status='Pending' AND expires_at<=@now", ("@now", Helpers.Now()));
            orderRows = (await db.ListAsync(@"SELECT o.id,o.code,o.amount_vnd,o.duration_months,o.status,o.order_type,o.grant_reason,
                o.premium_start_at,o.premium_end_at,o.created_at,o.expires_at,o.paid_at,o.review_note,
                o.bank_name,o.account_number,o.account_name,o.bank_bin,o.bank_receiver_id,
                u.username,u.full_name,COALESCE(admin.username,'') AS granted_by_name
                FROM orders o JOIN users u ON u.id=o.user_id LEFT JOIN users admin ON admin.id=o.reviewed_by
                ORDER BY o.created_at DESC LIMIT 200")).Select(x => JsonSerializer.SerializeToElement(x)).ToArray();
            auditRows = (await db.ListAsync("SELECT id,actor_id,action,subject_id,details,created_at FROM audit_logs ORDER BY created_at DESC LIMIT 200"))
                .Select(x => JsonSerializer.SerializeToElement(x)).ToArray();
            if (activeStoryId != "") await LoadEpisodes();
        }
        catch(Exception e){Notify(e.Message,true);}
        finally{loading=false;}
    }
    private void Notify(string text,bool error=false){message=text;failed=error;}
    private void NewStory(){editingStoryId="";story=new();}
    private void EditStory(JsonElement s)
    {
        editingStoryId=Ui.Str(s,"id");
        story=new(){Slug=Ui.Str(s,"slug"),Title=Ui.Str(s,"title"),Author=Ui.Str(s,"author"),Genre=Ui.Str(s,"genre"),
            Genres=Ui.Str(s,"genre_keys").Split('|',StringSplitOptions.RemoveEmptyEntries),
            Description=Ui.Str(s,"description"),CoverUrl=Ui.Str(s,"cover_url"),Status=Ui.Str(s,"status")};
    }
    private async Task SaveStory()
    {
        if(story.Genres.Length==0){Notify("Hãy chọn ít nhất một thể loại.",true);return;}
        busy=true;
        try
        {
            if(editingStoryId==""){var result=await Api.Post("/admin/stories",story);activeStoryId=Ui.Str(result,"id");}
            else await Api.Put("/admin/stories/"+Uri.EscapeDataString(editingStoryId),story);
            storyRows=Ui.Array(await Api.Get("/admin/stories"));
            if(activeStoryId!="") await LoadEpisodes();
            Notify("Đã lưu thông tin truyện. Tiếp theo, upload ảnh đại diện và các tập MP3 ở bước 2–3.");NewStory();
        }
        catch(Exception e){Notify(e.Message,true);}
        finally{busy=false;}
    }
    private void ToggleGenre(string key,bool selected)
    {
        story.Genres=selected ? story.Genres.Append(key).Distinct().ToArray() : story.Genres.Where(g=>g!=key).ToArray();
        story.Genre=genreRows.Where(g=>story.Genres.Contains(Ui.Str(g,"slug"))).Select(g=>Ui.Str(g,"name")).FirstOrDefault()??"";
    }
    private async Task AddGenre()
    {
        busy=true;
        try{await Api.Post("/admin/genres",new{name=newGenreName});newGenreName="";genreRows=Ui.Array(await Api.Get("/admin/genres"));Notify("Đã tạo thể loại.");}
        catch(Exception e){Notify(e.Message,true);}finally{busy=false;}
    }
    private void EditGenre(JsonElement g)
    {editGenreSlug=Ui.Str(g,"slug");editGenreName=Ui.Str(g,"name");editGenreActive=Ui.Num(g,"is_active")==1;}
    private async Task SaveGenre()
    {
        busy=true;
        try{await Api.Put("/admin/genres/"+Uri.EscapeDataString(editGenreSlug),new{name=editGenreName,isActive=editGenreActive});
            genreRows=Ui.Array(await Api.Get("/admin/genres"));editGenreSlug="";Notify("Đã cập nhật thể loại.");}
        catch(Exception e){Notify(e.Message,true);}finally{busy=false;}
    }
    private async Task DeleteGenre(string slug)
    {
        busy=true;
        try{await Api.Delete("/admin/genres/"+Uri.EscapeDataString(slug));
            genreRows=Ui.Array(await Api.Get("/admin/genres"));Notify("Đã xóa thể loại chưa sử dụng.");}
        catch(Exception e){Notify(e.Message,true);}finally{busy=false;}
    }
    private async Task ModerateReview(JsonElement review)
