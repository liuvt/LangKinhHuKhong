    private async Task ReplaceAudio()
    {
        if(editEpisodeId=="")return;
        var storyId=activeStoryId;
        var epId=editEpisodeId;
        var epNum=editEpisodeNumber;
        busy=true;
        uploadingAudio=true;
        uploadStatus="Đang thay thế MP3 và tải lên Cloudflare R2...";
        await InvokeAsync(StateHasChanged);
        try
        {
            await Api.ReplaceAudio(epId);
            uploadStatus="Đang kiểm tra trạng thái file mới trên Cloudflare R2...";
            await InvokeAsync(StateHasChanged);
            var check = await VerifyCloudflareAndSyncEpisodeAsync(storyId, epNum, epId);
            await LoadEpisodes();
            storageInfo=await Api.Get("/admin/storage");
            if (check.Verified)
                Notify($"Đã thay MP3, xác nhận đầy đủ trên {check.StorageMode} ({check.Detail}) và cập nhật thời lượng.");
            else
                Notify("Đã thay MP3, cập nhật thời lượng và tạo lại preview. Audio cũ đã được đưa vào hàng đợi dọn.");
        }
        catch(Exception e)
        {
            uploadStatus="Đang kiểm tra trạng thái file thay thế trên Cloudflare R2...";
            await InvokeAsync(StateHasChanged);
            var check = await VerifyCloudflareAndSyncEpisodeAsync(storyId, epNum, epId);
            if (check.Verified)
            {
                await LoadEpisodes();
                try { storageInfo=await Api.Get("/admin/storage"); } catch { }
                Notify($"Đã thay MP3 thành công! Đã xác nhận file mới trên {check.StorageMode} ({check.Detail}).");
                return;
            }
            Notify(check.ServerError != "" ? check.ServerError : e.Message,true);
        }
        finally
        {
            busy=false;
            uploadingAudio=false;
            uploadStatus="";
            await InvokeAsync(StateHasChanged);
        }
    }
