    // Returns false instead of announcing success if the list could not be loaded.
    // Retain the active story snapshot to prevent an older request overwriting a newer selection.
    private async Task<bool> LoadEpisodes(bool notifyOnError=true)
    {
        var storyId=activeStoryId;
        if (string.IsNullOrWhiteSpace(storyId))
        {
            episodeRows=[];
            textFileRows=[];
            await InvokeAsync(StateHasChanged);
            return true;
        }
        try
        {
            var epsTask = Api.Get("/admin/stories/" + Uri.EscapeDataString(storyId) + "/episodes").AsTask();
            var textsTask = Api.Get("/admin/stories/" + Uri.EscapeDataString(storyId) + "/texts").AsTask();
            await Task.WhenAll(epsTask, textsTask);
            var fresh = Ui.Array(await epsTask);
            var freshTexts = Ui.Array(await textsTask);
            if (storyId!=activeStoryId) return false;
            episodeRows=fresh;
            textFileRows=freshTexts;
            await InvokeAsync(StateHasChanged);
            return true;
        }
        catch(Exception e)
        {
            if (notifyOnError) Notify("Không tải được danh sách tập: "+e.Message,true);
            return false;
        }
    }
