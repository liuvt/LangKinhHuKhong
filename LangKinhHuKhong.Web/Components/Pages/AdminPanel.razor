@inject BrowserApi Api
@inject Database Database
@inject AudioStorage AudioStorage
@inject GoogleDriveService GoogleDrive
@inject NavigationManager Navigation

<section class="section top-section admin-page">
    <div class="section-heading"><div><small>ADMIN DASHBOARD</small><h1>Trung tâm quản trị</h1><p>Thành viên · Kho Audio · Gói Premium · Đơn hàng VietQR</p></div><button class="btn btn-outline" @onclick="Reload">↻ Tải lại</button></div>
    @if (!string.IsNullOrEmpty(message)) {<div class="alert @(failed?"alert-error":"alert-success")">@message <button @onclick='() => message = ""'>×</button></div>}
    <div class="stats-grid grid gap-4">
        <div class="stat rounded-2xl"><small>THÀNH VIÊN</small><strong>@Ui.Str(stats,"users")</strong></div>
        <div class="stat rounded-2xl"><small>BỘ TRUYỆN</small><strong>@Ui.Str(stats,"stories")</strong></div>
        <div class="stat rounded-2xl"><small>TẬP AUDIO</small><strong>@Ui.Str(stats,"episodes")</strong></div>
        <div class="stat rounded-2xl"><small>ĐƠN CHỜ</small><strong>@Ui.Str(stats,"pending")</strong></div>
        <div class="stat rounded-2xl"><small>PREMIUM</small><strong>@Ui.Str(stats,"premium")</strong></div>
        <div class="stat rounded-2xl"><small>ĐÃ ĐỐI SOÁT</small><strong class="stat-money">@Ui.Money(Ui.Num(stats,"income"))</strong></div>
    </div>
    <div class="admin-tabs flex flex-wrap gap-2">
        <button class="@(tab=="stories"?"active":"")" @onclick='() => tab = "stories"'>Kho truyện</button>
        <button class="@(tab=="notepad"?"active":"")" @onclick="SwitchToNotepadTab">📝 Bản thảo (.md/.txt)</button>
        <button class="@(tab=="genres"?"active":"")" @onclick='() => tab = "genres"'>Thể loại</button>
        <button class="@(tab=="reviews"?"active":"")" @onclick='() => tab = "reviews"'>Đánh giá</button>
        <button class="@(tab=="users"?"active":"")" @onclick='() => tab = "users"'>Thành viên</button>
        <button class="@(tab=="orders"?"active":"")" @onclick='() => tab = "orders"'>Thanh toán</button>
        <button class="@(tab=="banks"?"active":"")" @onclick='() => tab = "banks"'>Tài khoản QR</button>
        <button class="@(tab=="settings"?"active":"")" @onclick='() => tab = "settings"'>Cấu hình gói</button>
        <button class="@(tab=="audit"?"active":"")" @onclick='() => tab = "audit"'>Nhật ký</button>
    </div>
    @if (loading) {<div class="panel rounded-2xl">Đang tải bảng quản trị...</div>}
    else if(tab=="stories")
    {
        <div class="story-workflow rounded-2xl">
            <div class="workflow-step"><span class="workflow-number">1</span><div><b>Thông tin truyện</b><small>Tạo tên, thể loại, giới thiệu</small></div></div>
            <div class="workflow-step"><span class="workflow-number">2</span><div><b>Ảnh đại diện</b><small>Upload hoặc thay ảnh trên R2</small></div></div>
            <div class="workflow-step"><span class="workflow-number">3</span><div><b>Danh sách tập MP3</b><small>Thêm, sửa, thay file, xóa</small></div></div>
            <div class="workflow-step"><span class="workflow-number">4</span><div><b>Kho file chữ (.md, .txt)</b><small>Lưu trên VPS (0 hoặc nhiều file)</small></div></div>
        </div>
        <div class="two-column admin-columns grid gap-5">
            <div class="panel form rounded-2xl"><h2>@(editingStoryId == "" ? "Thêm bộ truyện" : "Chỉnh sửa bộ truyện")</h2>
                <label>Tên truyện<input @bind="story.Title" @bind:event="oninput" maxlength="180"/></label>
                <label>Slug (tự động, không dấu)<input readonly value="@(editingStoryId == "" ? Slugs.FromTitle(story.Title) : story.Slug)" /></label>
                <p class="hint">Slug được tạo từ tên truyện và tự thêm -2, -3 nếu trùng; sau khi tạo sẽ giữ nguyên để bảo vệ URL cũ.</p>
                <label>Tác giả<input @bind="story.Author" maxlength="120"/></label>
                <div class="genre-picker"><b>Thể loại (chọn nhiều)</b><div class="genre-option-grid">
                    @foreach(var g in genreRows.Where(x=>Ui.Num(x,"is_active")==1))
                    {
                        var key=Ui.Str(g,"slug");
                        <label class="genre-option"><input type="checkbox" checked="@story.Genres.Contains(key)" @onchange="e => ToggleGenre(key, e.Value is bool value && value)" /><span>@Ui.Str(g,"name")</span></label>
                    }
                </div><small>Muốn bổ sung thể loại? Chọn mục Thể loại ở trên.</small></div>
                <p class="hint">Ảnh đại diện được tải lên ở bước 2, lưu trực tiếp trên Cloudflare R2; không cần URL ảnh ngoài.</p>
                <label>Giới thiệu<textarea @bind="story.Description" rows="4" maxlength="15000"></textarea></label>
                <label>Trạng thái<select @bind="story.Status"><option value="Draft">Bản nháp</option><option value="Published">Phát hành</option><option value="Hidden">Ẩn</option></select></label>
                <button class="btn btn-primary" disabled="@busy" @onclick="SaveStory">@(editingStoryId==""?"Tạo truyện":"Lưu cập nhật")</button>
                @if(editingStoryId!=""){<button class="btn btn-outline" @onclick="NewStory">+ Thêm truyện mới</button>}
            </div>
            <div class="panel rounded-2xl"><h2>Danh sách bộ truyện (@storyRows.Length)</h2><div class="admin-story-list">@foreach(var s in storyRows){<div class="admin-story-item rounded-xl"><div><b>@Ui.Str(s,"title")</b><small>@Ui.Str(s,"slug") · @Ui.Str(s,"status") · @Ui.Num(s,"episode_count") tập MP3 · @Ui.Num(s,"text_count") file chữ · @Ui.Str(s,"genre_keys").Replace("|", " / ")</small></div><div class="table-actions"><button class="btn btn-sm btn-outline" @onclick="() => EditStory(s)">Sửa</button><button class="btn btn-sm btn-primary" @onclick='() => SelectStory(Ui.Str(s,"id"))'>MP3 &amp; File chữ</button></div></div>}</div></div>
        </div>
        @if(!string.IsNullOrEmpty(activeStoryId))
        {
            <div class="panel top-margin"><h2>Ảnh đại diện &amp; tập MP3 · @(storyRows.Where(x=>Ui.Str(x,"id")==activeStoryId).Select(x=>Ui.Str(x,"title")).FirstOrDefault())</h2>
                <p class="story-folder-label"><b>Thư mục R2:</b> <code>@ActiveStoryPrefix</code></p>
                <h3 class="step-title"><span>2</span> Ảnh đại diện bộ truyện</h3>
                <p class="hint">Khi thay ảnh, ứng dụng lưu ảnh mới trước, cập nhật tham chiếu trong SQLite, sau đó xóa object ảnh cũ trên R2. Nếu xóa lỗi, có thể dọn lại bên dưới.</p>
                <div class="upload-grid cover-upload">
                    <label>Ảnh bìa bộ truyện (JPG/PNG/WebP, tối đa 8MB)
                        <input id="cover-file" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    </label>
                    <button class="btn btn-primary" disabled="@busy" @onclick="UploadCover">@(string.IsNullOrWhiteSpace(Ui.Str(ActiveStory,"cover_file")) ? "↑ Upload ảnh bìa" : "↻ Thay ảnh bìa & dọn ảnh cũ")</button>
                    @if(Ui.Str(ActiveStory,"cover_file").StartsWith("cover-local:",StringComparison.Ordinal) && Ui.Str(storageInfo,"mode")=="R2")
                    { <button class="btn btn-outline" disabled="@busy" @onclick="MigrateCover">↑ Chuyển ảnh Local lên R2</button> }
                </div>
                @if(!string.IsNullOrWhiteSpace(ActiveCoverUrl))
                { <img src="@ActiveCoverUrl" class="admin-story-cover" alt="Ảnh bìa truyện" /> }
                <h3 class="step-title"><span>3</span> Upload và quản lý MP3</h3>
                <div class="upload-grid"><label>Tên tập<input @bind="episodeTitle" maxlength="180" placeholder="Tập 1: Mở đầu" /></label><label>Số tập<input type="number" @bind="episodeNumber" min="1" max="100000" /></label><label>Chọn file MP3 (tối đa 250MB)<input type="file" id="episode-file" accept=".mp3,audio/mpeg" /></label><button class="btn btn-primary" disabled="@busy" @onclick="UploadAudio">@(uploadingAudio ? "⏳ Đang xử lý MP3..." : "↑ Upload & tạo preview")</button></div>
                @if (uploadingAudio)
                {
                    <div class="episode-upload-progress" role="status" aria-live="polite">
                        <span class="episode-upload-spinner" aria-hidden="true"></span>
                        <div><b>@uploadStatus</b><small>MP3 có thể xuất hiện trên R2 trước khi FFmpeg, HLS và SQLite hoàn tất. Vui lòng chờ thông báo cuối cùng.</small></div>
                    </div>
                }
                <div class="storage-cleanup-bar"><div><b>Dọn dung lượng lưu trữ</b><small>Còn @Ui.Num(storageInfo,"cleanupPending") file cũ trong hàng đợi xóa</small></div><button class="btn btn-sm btn-outline" disabled="@busy" @onclick="RetryCleanup">↻ Dọn file cũ</button></div>
                <div class="r2-storage-notice">
                    <div><b>Kho lưu trữ: @(Ui.Str(storageInfo,"mode")=="R2" ? "☁ Cloudflare R2 riêng tư" : "Ổ đĩa Local")</b>
                    <small>@(Ui.Str(storageInfo,"mode")=="R2" ? "Bucket: " + Ui.Str(storageInfo,"bucket") + " · Image/, Episodes/, Previews/ trong mỗi bộ truyện." : "Chưa bật R2. Bật R2-Local.ps1 để upload vào thư mục riêng trên Cloudflare.")</small></div></div>
                <p class="hint">Máy chủ dùng FFmpeg tạo bản preview 300 giây. Bucket R2 phải giữ Private; không bật r2.dev/Public Development URL.</p>
                <div class="episode-list-toolbar">
                    <span><b>Danh sách tập (@episodeRows.Length)</b><small>Danh sách tự đồng bộ sau khi upload xong</small></span>
                    <button class="btn btn-sm btn-outline" disabled="@(busy || refreshingEpisodes)" @onclick="RefreshEpisodeList">@(refreshingEpisodes ? "⏳ Đang tải..." : "↻ Làm mới danh sách")</button>
                </div>
                <div class="table-scroll overflow-x-auto"><table><thead><tr><th>Số tập</th><th>Tiêu đề</th><th>Thời lượng</th><th>Trạng thái</th><th>Lưu trữ</th><th></th></tr></thead><tbody>@foreach(var ep in episodeRows){<tr @key='Ui.Str(ep,"id")' class="@(Ui.Str(ep,"id")==lastUploadedEpisodeId ? "episode-just-uploaded" : "")"><td>@Ui.Num(ep,"episode_number")</td><td>@Ui.Str(ep,"title")</td><td>@Ui.Duration(Ui.Num(ep,"duration_seconds"))</td><td>@Ui.Str(ep,"status")</td><td><span class="storage-pill @(Ui.Str(ep,"storage")=="R2" ? "storage-r2" : "storage-local")">@(Ui.Str(ep,"storage")=="R2" ? (Ui.Str(ep,"organization")=="Grouped" ? "☁ R2 / Truyện" : "☁ R2 cũ") : "💾 Local")</span><small class="hls-ready-label">@(Ui.Num(ep,"hls_ready")==1 ? "🔒 HLS Premium sẵn sàng" : "⚠ Chưa tạo HLS")</small></td><td><div class="table-actions"><button class="text-link" disabled="@busy" @onclick="() => EditEpisode(ep)">Sửa / Thay MP3</button>@if(Ui.Num(ep,"hls_ready")!=1) { <button class="btn btn-sm btn-outline" disabled="@busy" @onclick='() => PrepareHls(Ui.Str(ep,"id"))'>🔒 Tạo HLS</button> }<button class="btn btn-sm btn-danger-outline" disabled="@busy" @onclick="() => AskDeleteEpisode(ep)">Xóa</button>@if(Ui.Str(ep,"organization")!="Grouped" && Ui.Str(storageInfo,"mode")=="R2") { <button class="btn btn-sm btn-outline" disabled="@busy" @onclick='() => MigrateEpisode(Ui.Str(ep,"id"))'>↑ Vào thư mục truyện</button> }</div></td></tr>}</tbody></table></div>
                @if(editEpisodeId!="")
                {
                    <div class="inline-editor episode-editor">
                        <h3>Chỉnh sửa tập @editEpisodeNumber</h3>
                        <div class="two-column"><label>Tiêu đề<input @bind="editEpisodeTitle" maxlength="180" /></label><label>Thứ tự<input type="number" @bind="editEpisodeNumber" min="1" max="100000" /></label></div>
                        <label>Trạng thái<select @bind="editEpisodeStatus"><option value="Published">Phát hành</option><option value="Hidden">Ẩn</option></select></label>
                        <button class="btn btn-primary" disabled="@busy" @onclick="SaveEpisode">Lưu thông tin tập</button>
                        <div class="divider"></div>
                        <h3>Thay file MP3 của tập</h3>
                        <p class="hint">Chọn file mới sẽ cập nhật MP3 gốc và tạo lại Preview 5 phút cùng HLS mã hóa. MP3 cũ được xếp hàng dọn để tiết kiệm R2; tên tập và số thứ tự không thay đổi.</p>
                        <label>File MP3 mới (tối đa 250MB)<input id="replace-episode-file" type="file" accept=".mp3,audio/mpeg" /></label>
                        <button class="btn btn-outline" disabled="@busy" @onclick="ReplaceAudio">↻ Thay MP3 và tạo Preview mới</button>
                        <button class="btn btn-outline" disabled="@busy" @onclick='() => editEpisodeId = ""'>Đóng</button>
                    </div>
                }
                @if(deleteEpisodeId!="")
                {
                    <div class="delete-confirm-panel">
                        <strong>Xác nhận xóa vĩnh viễn tập?</strong>
                        <p>"@deleteEpisodeTitle" sẽ bị xóa khỏi danh sách và lịch sử nghe. File Full/Preview trên R2 cũng sẽ được xóa (hoặc xếp hàng thử lại). Không thể hoàn tác.</p>
                        <button class="btn btn-danger" disabled="@busy" @onclick="DeleteEpisode">Xác nhận xóa tập</button>
                        <button class="btn btn-outline" disabled="@busy" @onclick='() => deleteEpisodeId = ""'>Giữ lại tập</button>
                    </div>
                }

                <div class="divider"></div>
                <div class="episode-list-toolbar">
                    <div>
                        <h3 class="step-title" style="margin:0"><span>4</span> Kho lưu trữ file chữ (.md, .txt) — Tách 2 luồng: VPS hoặc Google Drive</h3>
                        <p class="hint" style="margin-top:0.25rem">
                            Mỗi bộ truyện có thể lưu trữ nhiều file bản thảo chữ (<code>.md</code>, <code>.txt</code>). Bạn có thể chọn <b>Upload lên VPS</b> hoặc <b>Upload lên Google Drive</b>.
                            @if (Ui.Bool(gdriveStatus, "connected"))
                            {
                                <span class="storage-pill storage-r2" style="margin-left:0.35rem">● Đã kết nối Google Drive (@(Ui.Str(gdriveStatus, "email") != "" ? Ui.Str(gdriveStatus, "email") : Ui.Str(gdriveStatus, "displayName")))</span>
                            }
                            else
                            {
                                <span class="storage-pill storage-local" style="margin-left:0.35rem">○ Chưa kết nối Google Drive</span>
                            }
                        </p>
                    </div>
                    <div class="table-actions">
                        @if (!Ui.Bool(gdriveStatus, "connected"))
                        {
                            <a class="btn btn-primary" href="/api/admin/gdrive/connect" data-enhance-nav="false">🔗 Kết nối tài khoản Google Drive</a>
                        }
                        else if (Ui.Str(gdriveStatus, "rootFolderUrl") != "")
                        {
                            <a class="btn btn-sm btn-outline" href="@Ui.Str(gdriveStatus, "rootFolderUrl")" target="_blank" rel="noopener">↗ Mở Google Drive</a>
                        }
                    </div>
                </div>
                <div class="upload-grid">
                    <label>Ghi chú / Tiêu đề (tùy chọn)
                        <input @bind="textFileTitle" maxlength="180" placeholder="Ví dụ: Bản thảo quyển 1, Toàn văn..." />
                    </label>
                    <label>Chọn 1 hoặc nhiều file (.md, .txt · tối đa 50MB/file)
                        <input type="file" id="story-text-files" multiple accept=".md,.txt,text/markdown,text/plain" />
                    </label>
                    <div class="table-actions" style="align-self:end">
                        <button class="btn btn-primary" disabled="@busy" @onclick='() => UploadStoryTexts("vps")'>@(uploadingTexts && uploadingTarget == "vps" ? "⏳ Đang lưu VPS..." : "💾 Upload lên VPS")</button>
                        <button class="btn btn-outline" disabled="@busy" @onclick='() => UploadStoryTexts("drive")'>@(uploadingTexts && uploadingTarget == "drive" ? "⏳ Đang lưu Drive..." : "☁ Upload lên Drive")</button>
                        <button class="btn btn-gold" disabled="@busy" @onclick='() => UploadStoryTexts("both")'>@(uploadingTexts && uploadingTarget == "both" ? "⏳ Đang lưu cả 2..." : "⇄ Giữ cả VPS & Drive (Dự phòng)")</button>
                    </div>
                </div>
                <div class="episode-list-toolbar">
                    <span><b>Danh sách file chữ của truyện (@textFileRows.Length)</b><small>Cho phép chuyển qua lại giữa VPS ⇄ Drive hoặc giữ trên cả 2 để làm dự phòng</small></span>
                    <div class="table-actions">
                        <button class="btn btn-sm btn-outline" disabled="@busy" @onclick='() => StartNewNotepadForStory(activeStoryId, "vps")'>💾 + Soạn mới (VPS)</button>
                        <button class="btn btn-sm btn-outline" disabled="@busy" @onclick='() => StartNewNotepadForStory(activeStoryId, "drive")'>☁ + Soạn mới (Drive)</button>
                        <button class="btn btn-sm btn-gold" disabled="@busy" @onclick='() => StartNewNotepadForStory(activeStoryId, "both")'>⇄ + Soạn mới (Cả 2 dự phòng)</button>
                    </div>
                </div>
                @if (textFileRows.Length == 0)
                {
                    <p class="hint">Bộ truyện này hiện chưa có file chữ nào (cho phép để trống hoặc tải lên nhiều file .md, .txt lên VPS, Google Drive hoặc cả 2 để dự phòng).</p>
                }
                else
                {
                    <div class="table-scroll overflow-x-auto">
                        <table>
                            <thead>
                                <tr>
                                    <th>Tiêu đề / Ghi chú</th>
                                    <th>Tên file gốc</th>
                                    <th>Định dạng</th>
                                    <th>Dung lượng</th>
                                    <th>Nơi lưu &amp; Chuyển đổi</th>
                                    <th>Cập nhật</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tf in textFileRows)
                                {
                                    var tfId = Ui.Str(tf, "id");
                                    var driveId = Ui.Str(tf, "drive_file_id");
                                    var target = NormalizeTarget(Ui.Str(tf, "storage_target"));
                                    <tr @key="tfId">
                                        <td><b>@Ui.Str(tf, "title")</b></td>
                                        <td class="mono">@Ui.Str(tf, "file_name")</td>
                                        <td><span class="pill">@Ui.Str(tf, "extension").ToUpperInvariant()</span></td>
                                        <td>@Ui.FileSize(Ui.Num(tf, "size_bytes"))</td>
                                        <td>
                                            <div class="table-actions" style="gap:0.35rem;align-items:center">
                                                <span class="storage-pill @TargetBadgeClass(target)">
                                                    @TargetBadgeText(target)
                                                </span>
                                                @if (target != "both")
                                                {
                                                    <button class="btn btn-sm btn-outline" title="Sao chép dự phòng để giữ ở cả VPS và Google Drive" disabled="@busy" @onclick='() => TransferTextFile(tf, "both")'>⇄ Giữ cả 2</button>
                                                }
                                                @if (target == "vps")
                                                {
                                                    <button class="btn btn-sm btn-outline" title="Chuyển file từ VPS sang Google Drive" disabled="@busy" @onclick='() => TransferTextFile(tf, "drive")'>→ Qua Drive</button>
                                                }
                                                else if (target == "drive")
                                                {
                                                    <button class="btn btn-sm btn-outline" title="Chuyển file từ Google Drive về VPS" disabled="@busy" @onclick='() => TransferTextFile(tf, "vps")'>← Về VPS</button>
                                                }
                                                else if (target == "both")
                                                {
                                                    <button class="btn btn-sm btn-outline" title="Kiểm tra 2 bên và ghi đè bằng bản cập nhật mới nhất" disabled="@busy" @onclick='() => TransferTextFile(tf, "both")'>↻ Đồng bộ mới nhất</button>
                                                    <button class="btn btn-sm btn-outline" title="Chỉ giữ trên VPS (xóa bản trên Drive)" disabled="@busy" @onclick='() => TransferTextFile(tf, "vps")'>Chỉ VPS</button>
                                                    <button class="btn btn-sm btn-outline" title="Chỉ giữ trên Drive (xóa bản trên VPS)" disabled="@busy" @onclick='() => TransferTextFile(tf, "drive")'>Chỉ Drive</button>
                                                }
                                            </div>
                                        </td>
                                        <td>@Ui.Date(Ui.Str(tf, "updated_at") != "" ? Ui.Str(tf, "updated_at") : Ui.Str(tf, "created_at"))</td>
                                        <td>
                                            <div class="table-actions">
                                                <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="() => OpenInNotepad(tfId)">✎ Sửa Notepad</button>
                                                <button class="btn btn-sm btn-outline" disabled="@busy" @onclick="() => PreviewTextFile(tfId)">Xem nhanh</button>
                                                <a class="btn btn-sm btn-outline" href="/api/admin/texts/@Uri.EscapeDataString(tfId)/download" target="_blank" rel="noopener">↓ Tải về</a>
                                                @if (driveId != "")
                                                {
                                                    <a class="btn btn-sm btn-outline" href="https://drive.google.com/file/d/@Uri.EscapeDataString(driveId)/view" target="_blank" rel="noopener">↗ Drive</a>
                                                }
                                                <button class="btn btn-sm btn-danger-outline" disabled="@busy" @onclick="() => DeleteTextFile(tf)">Xóa</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (previewTextId != "")
                {
                    <div class="inline-editor text-preview-panel">
                        <div class="episode-list-toolbar">
                            <div>
                                <h3>📄 @previewTextFileName</h3>
                                <small>@Ui.FileSize(previewTextSize) · @(previewTextTruncated ? "Đang hiển thị 256 KB đầu tiên (tải về để xem toàn bộ)" : "Hiển thị toàn bộ nội dung")</small>
                            </div>
                            <div class="table-actions">
                                <a class="btn btn-sm btn-primary" href="/api/admin/texts/@Uri.EscapeDataString(previewTextId)/download" target="_blank" rel="noopener">↓ Tải file gốc</a>
                                <button class="btn btn-sm btn-outline" @onclick='() => { previewTextId = ""; previewTextContent = ""; }'>Đóng</button>
                            </div>
                        </div>
                        <pre class="story-text-preview-box">@previewTextContent</pre>
                    </div>
                }
            </div>
        }
    }
    else if(tab=="notepad")
    {
        <div class="panel rounded-2xl gdrive-sync-panel">
            <div class="episode-list-toolbar">
                <div>
                    <h2>☁ Liên kết Google Drive &amp; Đồng bộ Dự phòng (VPS ⇄ Google Drive)</h2>
                    @if (Ui.Bool(gdriveStatus, "connected"))
                    {
                        <p class="hint">
                            <span class="storage-pill storage-r2">● Đã kết nối Google Drive</span>
                            Tài khoản: <b>@(Ui.Str(gdriveStatus, "email") != "" ? Ui.Str(gdriveStatus, "email") : Ui.Str(gdriveStatus, "displayName"))</b>
                            · Thư mục gốc: <code>@Ui.Str(gdriveStatus, "rootFolderName")</code>
                            · Hỗ trợ <b>3 chế độ</b>: lưu riêng trên <b>💾 VPS</b>, lưu riêng trên <b>☁ Google Drive</b>, hoặc <b>⇄ Giữ cả VPS &amp; Drive (Dự phòng)</b>. Có thể chuyển file từ Drive qua VPS hoặc từ VPS qua Drive bất kỳ lúc nào.
                        </p>
                    }
                    else if (Ui.Bool(gdriveStatus, "configured") || Ui.Bool(gdriveStatus, "hasClientConfig"))
                    {
                        <p class="hint">
                            <span class="storage-pill storage-local">○ Đã nạp OAuth Client (@Ui.Str(gdriveStatus, "clientIdPreview"))</span>
                            Bấm nút <b>"🔗 Kết nối tài khoản Google Drive"</b> màu xanh bên phải để cấp quyền lưu file vào thư mục <code>@(Ui.Str(gdriveStatus, "rootFolderName") != "" ? Ui.Str(gdriveStatus, "rootFolderName") : "LangKinhHuKhong-BanThao")</code> trên Google Drive của bạn.
                        </p>
                    }
                    else
                    {
                        <p class="hint">Chưa cấu hình OAuth Client ID/Secret. Bạn có thể nhập Client ID &amp; Client Secret bên dưới để kết nối Google Drive.</p>
                    }
                </div>
                <div class="table-actions">
                    @if (Ui.Bool(gdriveStatus, "connected"))
                    {
                        <button class="btn btn-gold" disabled="@(busy || syncingDrive)" @onclick="SyncBothDriveAndVps">@(syncingDrive ? "⏳ Đang đồng bộ..." : "⇄ Đồng bộ: Giữ cả VPS & Drive (Dự phòng)")</button>
                        <button class="btn btn-outline" disabled="@(busy || syncingDrive)" @onclick="SyncPushToDrive">☁ VPS → Drive</button>
                        <button class="btn btn-outline" disabled="@(busy || syncingDrive)" @onclick="SyncPullFromDrive">📥 Drive → VPS</button>
                        <button class="btn btn-outline" disabled="@busy" @onclick="ToggleDriveExplorer">@(showDriveExplorer ? "▲ Ẩn trình duyệt Drive" : "📂 Duyệt thư mục Drive")</button>
                        @if (Ui.Str(gdriveStatus, "rootFolderUrl") != "")
                        {
                            <a class="btn btn-outline" href="@Ui.Str(gdriveStatus, "rootFolderUrl")" target="_blank" rel="noopener">↗ Mở Google Drive</a>
                        }
                        <a class="btn btn-outline" href="/api/admin/gdrive/connect" data-enhance-nav="false">↻ Đổi tài khoản</a>
                        <button class="btn btn-danger-outline" disabled="@busy" @onclick="DisconnectGoogleDrive">Ngắt kết nối</button>
                    }
                    else
                    {
                        <a class="btn btn-primary" href="/api/admin/gdrive/connect" data-enhance-nav="false">🔗 Kết nối tài khoản Google Drive</a>
                        <button class="btn btn-outline" @onclick="() => showGdriveConfig = !showGdriveConfig">⚙ Cấu hình OAuth Client</button>
                    }
                </div>
            </div>

            @if (showGdriveConfig)
            {
                <div class="inline-editor top-margin">
                    <h3>⚙ Cấu hình Google Cloud OAuth 2.0 Client</h3>
                    <p class="hint">Authorized redirect URI cần khai báo trong Google Cloud Console: <code>@($"{Navigation.BaseUri.TrimEnd('/')}/api/admin/gdrive/callback")</code></p>
                    <div class="upload-grid">
                        <label>Client ID
                            <input @bind="gdriveClientIdInput" autocomplete="off" placeholder="...apps.googleusercontent.com" />
                        </label>
                        <label>Client Secret
                            <input type="password" @bind="gdriveClientSecretInput" autocomplete="new-password" placeholder="GOCSPX-..." />
                        </label>
                        <label>Tên thư mục gốc trên Google Drive
                            <input @bind="gdriveRootFolderInput" placeholder="LangKinhHuKhong-BanThao" />
                        </label>
                        <button class="btn btn-primary" disabled="@busy" @onclick="SaveGoogleDriveConfig">Lưu cấu hình OAuth</button>
                    </div>
                </div>
            }

            @if (showDriveExplorer && Ui.Bool(gdriveStatus, "connected"))
            {
                <div class="inline-editor top-margin">
                    <div class="episode-list-toolbar">
                        <div>
                            <h3>📂 Trình quản lý file trực tiếp trên Google Drive (CRUD)</h3>
                            <small>
                                Đang xem:
                                <button class="text-link" disabled="@busy" @onclick='() => BrowseDriveFolder("", "Thư mục gốc (" + Ui.Str(gdriveStatus, "rootFolderName") + ")")'>☁ @Ui.Str(gdriveStatus, "rootFolderName")</button>
                                @if (!string.IsNullOrWhiteSpace(driveCurrentFolderName) && driveCurrentFolderId != Ui.Str(gdriveStatus, "rootFolderId"))
                                {
                                    <span> / <b>@driveCurrentFolderName</b></span>
                                }
                            </small>
                        </div>
                        <div class="table-actions">
                            <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="StartNewDriveDirectNotepad">+ Tạo file .txt/.md trực tiếp trong thư mục này</button>
                            <button class="btn btn-sm btn-outline" disabled="@busy" @onclick="() => BrowseDriveFolder(driveCurrentFolderId, driveCurrentFolderName)">↻ Làm mới Drive</button>
                        </div>
                    </div>

                    <div class="upload-grid" style="margin-top:0.65rem">
                        <label>Tạo thư mục con mới trên Google Drive (trong thư mục hiện tại)
                            <input @bind="driveNewFolderName" maxlength="150" placeholder="Nhập tên thư mục mới..." />
                        </label>
                        <button class="btn btn-outline" disabled="@busy" @onclick="CreateDriveSubfolder">+ Tạo thư mục trên Drive</button>
                    </div>

                    @if (driveItems.Length == 0)
                    {
                        <p class="hint" style="margin-top:0.75rem">Thư mục Google Drive này hiện đang trống.</p>
                    }
                    else
                    {
                        <div class="table-scroll overflow-x-auto" style="margin-top:0.75rem">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Loại</th>
                                        <th>Tên trên Google Drive</th>
                                        <th>Dung lượng</th>
                                        <th>Cập nhật trên Drive</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in driveItems)
                                    {
                                        var dId = Ui.Str(item, "id");
                                        var dName = Ui.Str(item, "name");
                                        var isFolder = Ui.Bool(item, "isFolder");
                                        var webLink = Ui.Str(item, "webViewLink");
                                        <tr @key="dId">
                                            <td><span class="pill">@(isFolder ? "📁 THƯ MỤC" : "📄 FILE")</span></td>
                                            <td>
                                                @if (isFolder)
                                                {
                                                    <button class="text-link" disabled="@busy" @onclick="() => BrowseDriveFolder(dId, dName)"><b>📁 @dName</b></button>
                                                }
                                                else
                                                {
                                                    <span class="mono">@dName</span>
                                                }
                                            </td>
                                            <td>@(isFolder ? "—" : Ui.FileSize(Ui.Num(item, "sizeBytes")))</td>
                                            <td>@Ui.Date(Ui.Str(item, "modifiedTime"))</td>
                                            <td>
                                                <div class="table-actions">
                                                    @if (isFolder)
                                                    {
                                                        <button class="btn btn-sm btn-outline" disabled="@busy" @onclick="() => BrowseDriveFolder(dId, dName)">Mở thư mục</button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="() => OpenDriveFileInNotepad(dId)">✎ Sửa trên Notepad</button>
                                                    }
                                                    @if (webLink != "")
                                                    {
                                                        <a class="btn btn-sm btn-outline" href="@webLink" target="_blank" rel="noopener">↗ Xem trên Drive</a>
                                                    }
                                                    <button class="btn btn-sm btn-danger-outline" disabled="@busy" @onclick="() => DeleteDriveItemDirect(item)">Xóa khỏi Drive</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="panel top-margin rounded-2xl">
            <div class="episode-list-toolbar">
                <div>
                    <h2>📝 Quản lý Bản thảo (.md, .txt) &amp; Notepad Online (VPS / Google Drive / Dự phòng Cả 2)</h2>
                    <p class="hint">Khi upload hoặc soạn mới, bạn chọn lưu trên <b>💾 VPS</b>, lưu trên <b>☁ Google Drive</b>, hoặc <b>⇄ Giữ cả VPS &amp; Drive để làm dự phòng</b>. Từng file bên dưới đều có nút chuyển nhanh từ Drive qua VPS, từ VPS qua Drive hoặc giữ cả 2.</p>
                </div>
                <div class="table-actions">
                    <button class="btn btn-primary" disabled="@busy" @onclick='() => StartNewNotepadForStory(notepadFilterStoryId, "vps")'>💾 + Soạn mới (VPS)</button>
                    <button class="btn btn-outline" disabled="@busy" @onclick='() => StartNewNotepadForStory(notepadFilterStoryId, "drive")'>☁ + Soạn mới (Drive)</button>
                    <button class="btn btn-gold" disabled="@busy" @onclick='() => StartNewNotepadForStory(notepadFilterStoryId, "both")'>⇄ + Soạn mới (Cả 2 dự phòng)</button>
                    <button class="btn btn-outline" disabled="@busy" @onclick="LoadAllTextFiles">↻ Làm mới</button>
                </div>
            </div>

            <div class="upload-grid top-margin">
                <label>Bộ truyện nhận file upload
                    <select @bind="notepadUploadStoryId">
                        <option value="">-- Chọn bộ truyện --</option>
                        @foreach (var s in storyRows)
                        {
                            <option value="@Ui.Str(s, "id")">@Ui.Str(s, "title")</option>
                        }
                    </select>
                </label>
                <label>Ghi chú / Tiêu đề (tùy chọn)
                    <input @bind="notepadUploadTitle" maxlength="180" placeholder="Ví dụ: Bản thảo chương 1-20..." />
                </label>
                <label>Chọn 1 hoặc nhiều file (.md, .txt · tối đa 50MB/file)
                    <input type="file" id="notepad-text-files" multiple accept=".md,.txt,text/markdown,text/plain" />
                </label>
                <div class="table-actions" style="align-self:end">
                    <button class="btn btn-primary" disabled="@busy" @onclick='() => UploadFromNotepadTab("vps")'>@(uploadingTexts && uploadingTarget == "vps" ? "⏳ Đang lưu VPS..." : "💾 Upload lên VPS")</button>
                    <button class="btn btn-outline" disabled="@busy" @onclick='() => UploadFromNotepadTab("drive")'>@(uploadingTexts && uploadingTarget == "drive" ? "⏳ Đang lưu Drive..." : "☁ Upload lên Drive")</button>
                    <button class="btn btn-gold" disabled="@busy" @onclick='() => UploadFromNotepadTab("both")'>@(uploadingTexts && uploadingTarget == "both" ? "⏳ Đang lưu cả 2..." : "⇄ Upload cả 2 (VPS + Drive dự phòng)")</button>
                </div>
            </div>

            <div class="divider"></div>
            <div class="upload-grid" style="margin-bottom:0.75rem">
                <label>Lọc theo bộ truyện
                    <select @bind="notepadFilterStoryId">
                        <option value="">Tất cả bộ truyện (@allTextFileRows.Length file)</option>
                        @foreach (var s in storyRows)
                        {
                            var sid = Ui.Str(s, "id");
                            <option value="@sid">@Ui.Str(s, "title") (@Ui.Num(s, "text_count") file)</option>
                        }
                    </select>
                </label>
                <label>Lọc theo luồng lưu trữ
                    <select @bind="notepadFilterStorageTarget">
                        <option value="">Tất cả luồng (VPS + Google Drive)</option>
                        <option value="both">⇄ Đang giữ cả 2 nơi (VPS + Drive dự phòng)</option>
                        <option value="vps">💾 Chỉ lưu trên VPS</option>
                        <option value="drive">☁ Chỉ lưu trên Google Drive</option>
                    </select>
                </label>
                <label>Tìm kiếm theo tiêu đề hoặc tên file
                    <input @bind="notepadSearch" @bind:event="oninput" placeholder="Nhập tên file, chương, bộ truyện..." />
                </label>
            </div>

            @if (FilteredAllTextFiles.Length == 0)
            {
                <p class="hint">Không có file chữ (.md, .txt) nào khớp bộ lọc. Bạn có thể chọn "💾 Upload lên VPS", "☁ Upload lên Drive" hoặc "⇄ Upload cả 2 (VPS + Drive dự phòng)" ở trên.</p>
            }
            else
            {
                <div class="table-scroll overflow-x-auto">
                    <table>
                        <thead>
                            <tr>
                                <th>Bộ truyện</th>
                                <th>Tiêu đề / Ghi chú</th>
                                <th>Tên file</th>
                                <th>Định dạng</th>
                                <th>Dung lượng</th>
                                <th>Nơi lưu &amp; Chuyển đổi (VPS ⇄ Drive)</th>
                                <th>Cập nhật lúc</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tf in FilteredAllTextFiles)
                            {
                                var tfId = Ui.Str(tf, "id");
                                var driveId = Ui.Str(tf, "drive_file_id");
                                var target = NormalizeTarget(Ui.Str(tf, "storage_target"));
                                <tr @key="tfId" class="@(tfId == notepadFileId && notepadOpen ? "episode-just-uploaded" : "")">
                                    <td><b>@Ui.Str(tf, "story_title")</b></td>
                                    <td>@Ui.Str(tf, "title")</td>
                                    <td class="mono">@Ui.Str(tf, "file_name")</td>
                                    <td><span class="pill">@Ui.Str(tf, "extension").ToUpperInvariant()</span></td>
                                    <td>@Ui.FileSize(Ui.Num(tf, "size_bytes"))</td>
                                    <td>
                                        <div class="table-actions" style="gap:0.35rem;align-items:center">
                                            <span class="storage-pill @TargetBadgeClass(target)">
                                                @TargetBadgeText(target)
                                            </span>
                                            @if (target != "both")
                                            {
                                                <button class="btn btn-sm btn-outline" title="Sao chép dự phòng để giữ ở cả VPS và Google Drive" disabled="@busy" @onclick='() => TransferTextFile(tf, "both")'>⇄ Giữ cả 2</button>
                                            }
                                            @if (target == "vps")
                                            {
                                                <button class="btn btn-sm btn-outline" title="Chuyển file từ VPS sang Google Drive" disabled="@busy" @onclick='() => TransferTextFile(tf, "drive")'>→ Qua Drive</button>
                                            }
                                            else if (target == "drive")
                                            {
                                                <button class="btn btn-sm btn-outline" title="Chuyển file từ Google Drive về VPS" disabled="@busy" @onclick='() => TransferTextFile(tf, "vps")'>← Về VPS</button>
                                            }
                                            else if (target == "both")
                                            {
                                                <button class="btn btn-sm btn-outline" title="Kiểm tra 2 bên và ghi đè bằng bản cập nhật mới nhất" disabled="@busy" @onclick='() => TransferTextFile(tf, "both")'>↻ Đồng bộ mới nhất</button>
                                                <button class="btn btn-sm btn-outline" title="Chỉ giữ trên VPS (xóa bản trên Drive)" disabled="@busy" @onclick='() => TransferTextFile(tf, "vps")'>Chỉ VPS</button>
                                                <button class="btn btn-sm btn-outline" title="Chỉ giữ trên Drive (xóa bản trên VPS)" disabled="@busy" @onclick='() => TransferTextFile(tf, "drive")'>Chỉ Drive</button>
                                            }
                                        </div>
                                    </td>
                                    <td>@Ui.Date(Ui.Str(tf, "updated_at") != "" ? Ui.Str(tf, "updated_at") : Ui.Str(tf, "created_at"))</td>
                                    <td>
                                        <div class="table-actions">
                                            <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="() => OpenInNotepad(tfId)">✎ Mở Notepad</button>
                                            <a class="btn btn-sm btn-outline" href="/api/admin/texts/@Uri.EscapeDataString(tfId)/download" target="_blank" rel="noopener">↓ Tải về</a>
                                            @if (driveId != "")
                                            {
                                                <a class="btn btn-sm btn-outline" href="https://drive.google.com/file/d/@Uri.EscapeDataString(driveId)/view" target="_blank" rel="noopener">↗ Drive</a>
                                            }
                                            <button class="btn btn-sm btn-danger-outline" disabled="@busy" @onclick="() => AskDeleteNotepadFile(tf)">Xóa</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (deleteNotepadFileId != "")
            {
                <div class="delete-confirm-panel top-margin">
                    <strong>Xác nhận xóa vĩnh viễn file chữ?</strong>
                    <p>File "<b>@deleteNotepadFileName</b>" sẽ bị xóa khỏi @TargetDisplayLabel(deleteNotepadStorageTarget). Thao tác này không thể hoàn tác.</p>
                    <button class="btn btn-danger" disabled="@busy" @onclick="ConfirmDeleteNotepadFile">Xác nhận xóa file</button>
                    <button class="btn btn-outline" disabled="@busy" @onclick='() => { deleteNotepadFileId = ""; deleteNotepadFileName = ""; }'>Hủy</button>
                </div>
            }
        </div>

        @if (notepadOpen)
        {
            <div class="panel top-margin rounded-2xl notepad-editor-shell">
                <div class="episode-list-toolbar">
                    <div>
                        <h2>@(notepadDriveOnlyMode ? (notepadDriveFileId == "" ? "☁ Tạo file mới trực tiếp trong thư mục Google Drive" : $"☁ Đang sửa trực tiếp trên Google Drive: {notepadFileName}") : (notepadFileId == "" ? $"📝 Tạo file chữ mới — {TargetBadgeText(notepadStorageTarget)}" : $"✎ Đang chỉnh sửa ({TargetBadgeText(notepadStorageTarget)}): {notepadFileName}"))</h2>
                        <small>@(notepadDriveOnlyMode ? "Chế độ sửa trực tiếp trong trình duyệt thư mục Google Drive" : (notepadFileId == "" ? $"Nhập nội dung văn bản bên dưới và bấm Lưu để tạo file trên {TargetDisplayLabel(notepadStorageTarget)}" : $"Cập nhật lần cuối: {Ui.Date(notepadUpdatedAt)} · Dung lượng: {Ui.FileSize(notepadSizeBytes)}"))</small>
                    </div>
                    <div class="table-actions">
                        <button class="btn btn-primary" disabled="@(busy || savingNotepad)" @onclick="SaveNotepadFile">@(savingNotepad ? "⏳ Đang lưu..." : (notepadDriveOnlyMode ? "☁ Lưu lên Google Drive" : (notepadStorageTarget == "both" ? "⇄ Lưu cả VPS & Drive (Dự phòng)" : (notepadStorageTarget == "drive" ? "☁ Lưu lên Google Drive" : "💾 Lưu lên VPS"))))</button>
                        <button class="btn btn-outline" disabled="@busy" @onclick="CopyNotepadText">📋 Sao chép toàn bộ</button>
                        @if (!notepadDriveOnlyMode && notepadFileId != "")
                        {
                            <button class="btn btn-outline" disabled="@busy" @onclick="() => OpenInNotepad(notepadFileId)">↻ Tải lại bản gốc</button>
                            <a class="btn btn-outline" href="/api/admin/texts/@Uri.EscapeDataString(notepadFileId)/download" target="_blank" rel="noopener">↓ Tải về máy</a>
                        }
                        <button class="btn btn-outline" disabled="@busy" @onclick="CloseNotepad">× Đóng Notepad</button>
                    </div>
                </div>

                <div class="upload-grid top-margin">
                    @if (!notepadDriveOnlyMode)
                    {
                        <label>Thuộc bộ truyện
                            <select @bind="notepadStoryId">
                                <option value="">-- Chọn bộ truyện --</option>
                                @foreach (var s in storyRows)
                                {
                                    <option value="@Ui.Str(s, "id")">@Ui.Str(s, "title")</option>
                                }
                            </select>
                        </label>
                        <label>Luồng lưu trữ đích (Cho phép chuyển đổi khi Lưu)
                            <select @bind="notepadStorageTarget">
                                <option value="vps">💾 Chỉ lưu trên VPS (Ổ đĩa máy chủ)</option>
                                <option value="drive">☁ Chỉ lưu trên Google Drive</option>
                                <option value="both">⇄ Giữ cả VPS &amp; Google Drive (Dự phòng)</option>
                            </select>
                        </label>
                        <label>Tiêu đề / Ghi chú
                            <input @bind="notepadTitle" maxlength="180" placeholder="Ví dụ: Chương 1 - Mở đầu" />
                        </label>
                    }
                    <label>Tên file lưu trữ (.md hoặc .txt)
                        <input @bind="notepadFileName" maxlength="200" placeholder="chuong-01.txt" />
                    </label>
                    <label>Định dạng
                        <select @bind="notepadExtension">
                            <option value=".txt">.TXT (Text thuần)</option>
                            <option value=".md">.MD (Markdown)</option>
                        </select>
                    </label>
                </div>

                <div class="notepad-statusbar">
                    <span id="admin-notepad-stats" class="mono">1 dòng · 0 từ · 0 ký tự</span>
                    <span>Mã hóa: <b>UTF-8</b> · Luồng lưu trữ: <b>@(notepadDriveOnlyMode ? "☁ Google Drive" : TargetDisplayLabel(notepadStorageTarget))</b> · Phím <code>Tab</code> hỗ trợ thụt lề 2 khoảng trắng</span>
                </div>

                <textarea id="admin-notepad-editor" class="online-notepad-textarea" spellcheck="false" placeholder="Nhập hoặc dán nội dung văn bản (.md / .txt) tại đây..."></textarea>
            </div>
        }
    }
    else if(tab=="genres")
    {
        <div class="panel form rounded-2xl"><h2>Danh mục thể loại</h2>
            <p class="hint">Có thể thêm, đổi tên hoặc ẩn thể loại. Thể loại đang gắn với truyện không thể xóa trực tiếp.</p>
