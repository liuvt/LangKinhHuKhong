    private async Task TransferTextFile(JsonElement tf, string targetMode)
    {
        if (busy) return;
        var tfId = Ui.Str(tf, "id");
        var fname = Ui.Str(tf, "file_name");
        var target = NormalizeTarget(targetMode);
        if (string.IsNullOrWhiteSpace(tfId)) return;
        if ((target == "drive" || target == "both") && !Ui.Bool(gdriveStatus, "connected"))
        {
            Notify("Chưa kết nối tài khoản Google Drive. Vui lòng kết nối Google Drive ở trên trước khi chuyển hoặc sao lưu sang Drive.", true);
            return;
        }
        busy = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var res = await Api.Post("/admin/texts/" + Uri.EscapeDataString(tfId) + "/transfer", new { target });
            if (notepadFileId == tfId && notepadOpen)
            {
                notepadStorageTarget = NormalizeTarget(Ui.Str(res, "storage_target"));
                await OpenInNotepad(tfId);
            }
            allTextFileRows = Ui.Array(await Api.Get("/admin/texts"));
            storyRows = Ui.Array(await Api.Get("/admin/stories"));
            if (activeStoryId != "") await LoadEpisodes(false);
            if (showDriveExplorer) await BrowseDriveFolder(driveCurrentFolderId, driveCurrentFolderName);
            var msg = Ui.Str(res, "message");
            Notify(!string.IsNullOrWhiteSpace(msg)
                ? msg
                : (target switch
                {
                    "both" => $"Đã đồng bộ dự phòng file '{fname}' bằng bản cập nhật mới nhất.",
                    "drive" => $"Đã chuyển file '{fname}' từ VPS sang Google Drive.",
                    _ => $"Đã chuyển file '{fname}' từ Google Drive về VPS."
                }));
        }
        catch (Exception e)
        {
            Notify("Chuyển đổi nơi lưu trữ thất bại: " + e.Message, true);
        }
        finally
        {
            busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }
