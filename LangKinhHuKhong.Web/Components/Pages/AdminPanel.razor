                    <div class="bank-order-snapshot"><b>Tài khoản cần đối soát</b><p>@activeOrderBank · @activeOrderAccountNumber · @activeOrderAccountName</p><small>Thông tin người nhận được lưu tại thời điểm tạo đơn.</small></div>
                    @if(activeOrderStatus is "Pending" or "Reviewing")
                    {
