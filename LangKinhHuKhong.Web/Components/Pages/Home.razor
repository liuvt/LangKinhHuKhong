    private bool Matches(JsonElement st) => (genre==""||Ui.Str(st,"genres").Split(" | ").Any(name=>genreCatalog.Any(g=>Ui.Str(g,"slug")==genre && Ui.Str(g,"name")==name)))
        && (string.IsNullOrEmpty(search) || Ui.Str(st,"title").Contains(search,StringComparison.OrdinalIgnoreCase)||Ui.Str(st,"author").Contains(search,StringComparison.OrdinalIgnoreCase));
    private async Task ReloadReviews(string slug)
    {
        await using var db = await Database.OpenAsync();
        var story = await db.FirstAsync("SELECT id FROM stories WHERE slug=@s AND status='Published'", ("@s", slug));
        if (story is null) { reviews = []; return; }
        await LoadReviewsByStoryIdFromDbAsync(db, story.S("id"));
    }
    private async Task SaveReview()
    {
        if(!isAuthenticated){authMode="login";return;}
        busy=true;
        try
        {
            var slug=Ui.Str(Ui.Property(detail,"story"),"slug");
            var res=await Api.Put("/stories/"+Uri.EscapeDataString(slug)+"/reviews/me",new{stars=myReviewStars,body=myReviewBody});
            await LoadStory(slug);
            var msg=Ui.Str(res,"message");
            Notice(string.IsNullOrWhiteSpace(msg) ? "Đã cập nhật đánh giá của bạn." : msg, Ui.Str(res,"status")=="Hidden");
        }
        catch(Exception e){Notice(e.Message,true);}finally{busy=false;}
    }
    private async Task DeleteReview()
    {
        busy=true;
        try
        {
            var slug=Ui.Str(Ui.Property(detail,"story"),"slug");
            await Api.Delete("/stories/"+Uri.EscapeDataString(slug)+"/reviews/me");
            myReviewBody="";myReviewStars=5;hasOwnReview=false;myReviewHidden=false;
            await LoadStory(slug); Notice("Đã xóa đánh giá của bạn.");
        }
        catch(Exception e){Notice(e.Message,true);}finally{busy=false;}
    }
    private void Notice(string text,bool error=false){message=text;messageIsError=error;}
    private async Task SubmitAuth()
    {
        busy=true;authError="";
        try
        {
            if(authMode=="login")
            {
                var res = await Api.Post("/auth/login", new { username, password });
                var loggedUser = Ui.Property(res, "user");
                user = loggedUser.ValueKind == JsonValueKind.Object ? loggedUser : await Api.Get("/auth/me");
                sessionChecked = true;
                authMode = "";
                password = "";
                profileName = Ui.Str(user, "fullName");
                profilePhone = Ui.Str(user, "phone");
                profileAddress = Ui.Str(user, "address");
                StateHasChanged();
                var refreshTasks = new List<Task> { LoadListeningSafeAsync() };
                if (page == "story" && CurrentRoute().StartsWith("truyen/", StringComparison.OrdinalIgnoreCase))
                    refreshTasks.Add(SafeReloadReviewsAsync(Uri.UnescapeDataString(CurrentRoute()["truyen/".Length..])));
                if (page == "premium")
                    refreshTasks.Add(LoadPremium());
                await Task.WhenAll(refreshTasks);
            }
            else
            {
                var res = await Api.Post("/auth/register", new { username, password, fullName = registerName, phone = registerPhone, address = registerAddress });
                var registeredUser = Ui.Property(res, "user");
                password = "";
                if (registeredUser.ValueKind == JsonValueKind.Object)
                {
                    user = registeredUser;
                    sessionChecked = true;
                    authMode = "";
                    profileName = Ui.Str(user, "fullName");
                    profilePhone = Ui.Str(user, "phone");
                    profileAddress = Ui.Str(user, "address");
                    Notice("Đăng ký và đăng nhập thành công.");
                    StateHasChanged();
                }
                else
                {
                    authMode = "login";
                    Notice("Đăng ký thành công. Hãy đăng nhập.");
                }
            }
        }
        catch(Exception e){authError=e.Message;}
        finally{busy=false;}
    }
