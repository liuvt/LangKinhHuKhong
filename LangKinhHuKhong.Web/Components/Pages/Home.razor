    private async Task ChangePassword()
    {
        if (newPassword != confirmPassword) { Notice("Xác nhận mật khẩu mới không khớp.", true); return; }
        if (newPassword.Length < 12 || newPassword.Length > 128) { Notice("Mật khẩu mới cần từ 12 đến 128 ký tự.", true); return; }
        busy=true;
        try
        {
            await Api.Post("/auth/change-password", new { currentPassword, newPassword });
            currentPassword="";newPassword="";confirmPassword="";
            await Api.Reload();
        }
        catch(Exception e) { Notice(e.Message,true); }
        finally { busy=false; }
    }
