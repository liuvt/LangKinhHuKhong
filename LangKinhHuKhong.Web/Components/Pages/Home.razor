@page "/"
@page "/thu-vien"
@page "/the-loai/{GenreSlug}"
@page "/truyen/{Slug}"
@page "/lich-su"
@page "/tai-khoan"
@page "/premium"
@page "/quan-tri"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Http
@using Microsoft.Data.Sqlite
@inject BrowserApi Api
@inject Database Database
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpContextAccessor HttpContextAccessor
@implements IAsyncDisposable

<SeoHead @key="CurrentRoute()" Route="@CurrentRoute()" />

<div class="app-layout min-h-screen bg-slate-50 text-slate-900">
    @if (mobileMenuOpen)
    {
        <button class="nav-scrim" aria-label="Đóng menu điều hướng" @onclick='() => mobileMenuOpen = false'></button>
    }
    <aside class="sidebar @(mobileMenuOpen ? "is-open" : "")" aria-label="Điều hướng chính">
        <a class="brand" href="/">
            <span class="brand-symbol"><img class="lkh-brand-logo" src="/images/lkh-logo.webp" alt="Logo Lăng Kính Hư Không – nghe truyện audio" width="58" height="58" /></span>
            <span class="brand-words">LĂNG KÍNH <strong>HƯ KHÔNG</strong><small>NGHE TRUYỆN · TRUYỆN AUDIO</small></span>
        </a>
        <div class="sidebar-inner">
            <div class="side-caption">KHÁM PHÁ</div>
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All"><AppIcon Name="home" /><span>Trang chủ</span></NavLink>
            <NavLink class="@("nav-item" + (page == "story" ? " active" : ""))" href="/thu-vien" Match="NavLinkMatch.All"><AppIcon Name="library" /><span>Thư viện truyện</span></NavLink>
            <NavLink class="nav-item" href="/lich-su" Match="NavLinkMatch.All"><AppIcon Name="history" /><span>Lịch sử xem &amp; nghe</span></NavLink>
            <div class="side-caption">TÀI KHOẢN</div>
            <NavLink class="nav-item" href="/premium" Match="NavLinkMatch.All"><AppIcon Name="crown" /><span>@(isPremium ? "Premium của tôi" : "Gói Premium")</span>@if(!isPremium){<span class="nav-new">PRO</span>}</NavLink>
            <NavLink class="nav-item" href="/tai-khoan" Match="NavLinkMatch.All"><AppIcon Name="user" /><span>Hồ sơ cá nhân</span></NavLink>
            @if (isAdmin)
            {
                <NavLink class="nav-item" href="/quan-tri" Match="NavLinkMatch.All"><AppIcon Name="settings" /><span>Quản trị hệ thống</span></NavLink>
            }
        </div>
        @if(isPremium)
        {
            <a class="sidebar-premium" href="/premium">
                <span class="sidebar-premium-icon"><AppIcon Name="crown" /></span>
                <b>Premium đang hoạt động</b>
                <small>Hết hạn: @Ui.Date(Ui.Str(user,"premiumUntil"))</small>
                <span class="sidebar-upgrade">Gia hạn thêm <AppIcon Name="arrow-right" Size="15" /></span>
            </a>
        }
        else
        {
            <a class="sidebar-premium" href="/premium">
                <span class="sidebar-premium-icon"><AppIcon Name="crown" /></span>
                <b>Nghe không giới hạn</b>
                <small>Mở khóa trọn vẹn mọi câu chuyện với Premium.</small>
                <span class="sidebar-upgrade">Khám phá gói <AppIcon Name="arrow-right" Size="15" /></span>
            </a>
        }
        <div class="side-footer"><span class="online-dot"></span> Lăng Kính Hư Không <small>© 2026 · Audio Library</small></div>
    </aside>

    <div class="main-column min-w-0">
        <header class="topbar">
            <div class="topbar-leading">
                <button class="mobile-menu-btn" aria-label="Mở menu" @onclick='() => mobileMenuOpen = true'><AppIcon Name="menu" Size="22" /></button>
                <a href="/" class="mobile-brand"><img src="/images/lkh-logo.webp" width="34" height="34" alt="Logo Lăng Kính Hư Không" /> Lăng Kính Hư Không</a>
                <div class="desktop-greeting"><b>@NavigationHeading</b><small>@DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</small></div>
            </div>
            <div class="topbar-actions">
                <div class="searchbar"><AppIcon Name="search" Size="18" /><input aria-label="Tìm kiếm truyện" placeholder="Tìm tên truyện, tác giả..." @bind="search" @bind:event="oninput" @onkeydown="HandleSearchKey" />@if (!string.IsNullOrEmpty(search)) { <button type="button" class="searchbar-clear" title="Xóa từ khóa" aria-label="Xóa từ khóa tìm kiếm" @onclick='() => search = ""'>×</button> }<a href="/thu-vien" aria-label="Xem kết quả tìm kiếm"><AppIcon Name="arrow-right" Size="17" /></a></div>
                @if (isAuthenticated)
                {
                    <div class="top-account"><span class="account-avatar">@Ui.Str(user,"username").FirstOrDefault()</span><div><b>@Ui.Str(user,"username")</b><small>@(isPremium ? "Premium member" : "Thành viên Free")</small></div><button class="logout-btn" title="Đăng xuất" aria-label="Đăng xuất" @onclick="Logout"><AppIcon Name="log-out" Size="19" /></button></div>
                }
                else
                {
                    <button class="btn btn-outline login-button" @onclick='() => authMode = "login"'>Đăng nhập</button>
                    <button class="btn btn-primary top-register" @onclick='() => authMode = "register"'>Đăng ký miễn phí</button>
                }
            </div>
        </header>
        <div class="main-content" @key="page">
            @if (!string.IsNullOrEmpty(message)) { <div class="alert @(messageIsError ? "alert-error" : "alert-success")" role="status">@message <button aria-label="Đóng" @onclick='() => message = ""'>×</button></div> }
            @if (loading) { <div class="panel skeleton">Đang tải dữ liệu...</div> }
            else if (page == "home")
            {
                <section class="section top-section home-stories">
                    <div class="section-heading flex flex-wrap items-end justify-between gap-4">
                        <div>
                            <small>CHƯƠNG MỚI LÊN SÓNG</small>
                            <h1>Các bộ truyện vừa được cập nhật chương mới</h1>
                            <p>Theo dõi ngay những bộ truyện audio vừa có tập mới phát hành gần đây nhất.</p>
                        </div>
                        <a href="/thu-vien?sort=updated">Xem tất cả chương mới →</a>
                    </div>
                    <div class="story-grid grid gap-5">
                        @foreach (var story in (updatedStories.Length > 0 ? updatedStories : newestStories).Take(8))
                        {
                            var latestEpNo = Ui.Num(story, "latestEpisodeNumber");
                            var latestEpTitle = Ui.Str(story, "latestEpisodeTitle");
                            var timeAgo = Ui.TimeAgo(Ui.Str(story, "latestEpisodeAt"));
                            <a class="story-card group transition-all duration-200" href="@StoryUrl(story)">
                                <div class="cover">
                                    <span class="cover-fallback">◈</span>
                                    @if (!string.IsNullOrWhiteSpace(Ui.Str(story, "cover_url")))
                                    {
                                        <img src="@Ui.Str(story, "cover_url")" alt="@Ui.Str(story, "title")" loading="lazy" />
                                    }
                                    <span class="cover-badge cover-badge-new">@(latestEpNo > 0 ? $"Tập {latestEpNo} · MỚI" : "MỚI")</span>
                                    @if (!string.IsNullOrEmpty(timeAgo))
                                    {
                                        <span class="cover-badge-time">@timeAgo</span>
                                    }
                                    <span class="cover-play"><AppIcon Name="play" Size="19" /></span>
                                </div>
                                <h3>@Ui.Str(story, "title")</h3>
                                @if (latestEpNo > 0)
                                {
                                    <div class="latest-ep-pill" title="@latestEpTitle">♫ @(string.IsNullOrWhiteSpace(latestEpTitle) ? $"Tập {latestEpNo}" : latestEpTitle)</div>
                                }
                                else
                                {
                                    <p>@Ui.Str(story, "author")</p>
                                }
                                <div class="story-meta">@Ui.Str(story, "genres") · @Ui.Num(story, "episodeCount") tập</div>
                                <div class="story-trends"><span>◉ @Ui.Num(story, "listenerCount") người nghe</span> <span>★ @Ui.Str(story, "ratingAverage")</span></div>
                            </a>
                        }
                    </div>
                    @if (stories.Length == 0)
                    {
                        <div class="empty">Chưa có truyện nào được phát hành. Admin có thể tạo bộ truyện và tải MP3 tại Dashboard.</div>
                    }
                </section>

                @if (newestStories.Length > 0)
                {
                    <section class="section">
                        <div class="section-heading flex flex-wrap items-end justify-between gap-4">
                            <div>
                                <small>KHO TRUYỆN MỚI</small>
                                <h2>Nghe truyện audio mới tại Lăng Kính Hư Không</h2>
                                <p>Nghe audio truyện tiên hiệp, kiếm hiệp, xuyên không và huyền huyễn bằng giọng đọc tiếng Việt.</p>
                            </div>
                            <a href="/thu-vien?sort=new">Tất cả truyện →</a>
                        </div>
                        <div class="story-grid grid gap-5">
                            @foreach (var story in newestStories.Take(8))
                            {
                                <a class="story-card group transition-all duration-200" href="@StoryUrl(story)">
                                    <div class="cover">
                                        <span class="cover-fallback">◈</span>
                                        @if (!string.IsNullOrWhiteSpace(Ui.Str(story, "cover_url")))
                                        {
                                            <img src="@Ui.Str(story, "cover_url")" alt="@Ui.Str(story, "title")" loading="lazy" />
                                        }
                                        <span class="cover-play"><AppIcon Name="play" Size="19" /></span>
                                    </div>
                                    <h3>@Ui.Str(story, "title")</h3>
                                    <p>@Ui.Str(story, "author")</p>
                                    <div class="story-meta">@Ui.Str(story, "genres") · @Ui.Num(story, "episodeCount") tập</div>
                                    <div class="story-trends"><span>◉ @Ui.Num(story, "listenerCount") người nghe</span> <span>★ @Ui.Str(story, "ratingAverage")</span></div>
                                </a>
                            }
                        </div>
                    </section>
                }

                @if (popularStories.Length > 0)
                {
                    <section class="section">
                        <div class="section-heading flex flex-wrap items-end justify-between gap-4">
                            <div>
                                <small>ĐƯỢC QUAN TÂM</small>
                                <h2>Top nghe nhiều</h2>
                                <p>Bảng xếp hạng các bộ truyện được thính giả nghe nhiều và yêu thích nhất.</p>
                            </div>
                            <a href="/thu-vien?sort=popular">Xem bảng xếp hạng →</a>
                        </div>
                        <div class="story-grid grid gap-5">
                            @for (var rankIdx = 0; rankIdx < Math.Min(8, popularStories.Length); rankIdx++)
                            {
                                var story = popularStories[rankIdx];
                                var rankNo = rankIdx + 1;
                                <a class="story-card group transition-all duration-200" href="@StoryUrl(story)">
                                    <div class="cover">
                                        <span class="cover-fallback">◈</span>
                                        @if (!string.IsNullOrEmpty(Ui.Str(story, "cover_url")))
                                        {
                                            <img src="@Ui.Str(story, "cover_url")" alt="@Ui.Str(story, "title")" loading="lazy" />
                                        }
                                        <span class="cover-badge cover-badge-rank @(rankNo <= 3 ? $"rank-{rankNo}" : "")">@(rankNo <= 3 ? $"TOP {rankNo}" : $"#{rankNo}")</span>
                                        <span class="cover-play"><AppIcon Name="play" Size="19" /></span>
                                    </div>
                                    <h3>@Ui.Str(story, "title")</h3>
                                    <p>@Ui.Str(story, "author")</p>
                                    <div class="story-meta">@Ui.Str(story, "genres") · @Ui.Num(story, "episodeCount") tập</div>
                                    <div class="story-trends"><span>◉ @Ui.Num(story, "listenerCount") người nghe</span><span>★ @Ui.Str(story, "ratingAverage")</span></div>
                                </a>
                            }
                        </div>
                    </section>
                }

                <section class="section">
                    <div class="section-heading flex flex-wrap items-end justify-between gap-4">
                        <div>
                            <small>QUAY LẠI THẾ GIỚI TRUYỆN</small>
                            <h2>Lịch sử xem &amp; nghe gần đây</h2>
                        </div>
                        <a href="/lich-su">Xem tất cả →</a>
                    </div>
                    @if (!isAuthenticated)
                    {
                        <div class="empty history-empty-inline">
                            <span>Đăng nhập để tự động lưu lịch sử xem truyện và vị trí tập đang nghe.</span>
                            <button type="button" class="btn btn-outline btn-sm" @onclick='() => authMode = "login"'>Đăng nhập ngay</button>
                        </div>
                    }
                    else if (history.Length == 0)
                    {
                        <div class="empty history-empty-inline">Bạn chưa xem hoặc nghe bộ truyện nào gần đây. Hãy mở một bộ truyện bất kỳ để lưu lịch sử.</div>
                    }
                    else
                    {
                        <div class="history-grid">
                            @foreach (var item in history.Take(6))
                            {
                                var epTitle = Ui.Str(item, "episode_title");
                                var listenedSec = Ui.Num(item, "seconds");
                                var ago = Ui.TimeAgo(Ui.Str(item, "updated_at"));
                                <button class="history-item history-card" @onclick="() => OpenHistory(item)">
                                    <span class="history-thumb">
                                        @if (!string.IsNullOrWhiteSpace(Ui.Str(item, "cover_url")))
                                        {
                                            <img src="@Ui.Str(item, "cover_url")" alt="@Ui.Str(item, "story_title")" loading="lazy" />
                                        }
                                        else
                                        {
                                            <AppIcon Name="play" Size="18" />
                                        }
                                    </span>
                                    <span>
                                        <b>@Ui.Str(item, "story_title")</b>
                                        <small>@(epTitle != "" ? $"{epTitle} · Đã nghe {Ui.Duration(listenedSec)}" : "Đã xem chi tiết truyện")@(ago != "" ? $" · {ago}" : "")</small>
                                    </span>
                                    <span class="icon-chevron">›</span>
                                </button>
                            }
                        </div>
                    }
                </section>
            }
            else if (page == "library")
            {
                var currentLibraryList = sortMode switch
                {
                    "popular" => popularStories,
                    "new" => newestStories,
                    _ => updatedStories.Length > 0 ? updatedStories : newestStories
                };
                <section class="section top-section"><div class="section-heading flex flex-wrap items-end justify-between gap-4"><div><small>KHÁM PHÁ</small><h1>@(genre == "" ? "Thư viện truyện audio Lăng Kính Hư Không" : $"Nghe truyện {GenreName} audio")</h1><p>Đọc giới thiệu truyện audio, chọn thể loại và nghe audio ngay tại Lăng Kính Hư Không.</p></div></div>
                <div class="genre-tabs"><a class="genre @(genre==""?"selected":"")" href="/thu-vien">Tất cả</a>
                    @foreach (var g in genreCatalog)
                    {
                        var genreSlug = Ui.Str(g, "slug");
                        <a class="@(genre == genreSlug ? "genre selected" : "genre")"
                                href="@($"/the-loai/{Uri.EscapeDataString(genreSlug)}")">@Ui.Str(g, "name")</a>
                    }</div>
                <div class="sort-tabs">
                    <button class="genre @(sortMode=="updated"?"selected":"")" @onclick='() => sortMode="updated"'>Chương mới cập nhật</button>
                    <button class="genre @(sortMode=="new"?"selected":"")" @onclick='() => sortMode="new"'>Truyện mới đăng</button>
                    <button class="genre @(sortMode=="popular"?"selected":"")" @onclick='() => sortMode="popular"'>Top nghe nhiều</button>
                </div>
                <div class="story-grid grid gap-5">@foreach (var story in currentLibraryList.Where(Matches)) { var latestEpNo = Ui.Num(story, "latestEpisodeNumber"); var latestEpTitle = Ui.Str(story, "latestEpisodeTitle"); <a class="story-card group transition-all duration-200" href="@StoryUrl(story)"><div class="cover"><span class="cover-fallback">◈</span>@if(!string.IsNullOrEmpty(Ui.Str(story,"cover_url"))){<img src="@Ui.Str(story,"cover_url")" alt="@Ui.Str(story,"title")" loading="lazy"/>}@if(sortMode=="updated" && latestEpNo > 0){<span class="cover-badge cover-badge-new">Tập @latestEpNo · MỚI</span>}<span class="cover-play"><AppIcon Name="play" Size="19" /></span></div><h3>@Ui.Str(story,"title")</h3>@if(sortMode=="updated" && latestEpNo > 0){<div class="latest-ep-pill" title="@latestEpTitle">♫ @(string.IsNullOrWhiteSpace(latestEpTitle) ? $"Tập {latestEpNo}" : latestEpTitle)</div>}else{<p>@Ui.Str(story,"author")</p>}<div class="story-meta">@Ui.Str(story,"genres") · @Ui.Num(story,"episodeCount") tập</div><div class="story-trends"><span>◉ @Ui.Num(story,"listenerCount") người nghe</span> <span>★ @Ui.Str(story,"ratingAverage")</span></div></a> }</div>
                @if(!currentLibraryList.Any(Matches)){<div class="empty">Không có truyện phù hợp với bộ lọc.</div>}
                </section>
            }
            else if (page == "story")
            {
                <a href="/thu-vien" class="back-link">← Quay lại thư viện</a>
                @if (Ui.Property(detail,"story").ValueKind == JsonValueKind.Object)
                {
                    var st=Ui.Property(detail,"story");
                    <div class="detail-panel">
                        <div class="detail-hero">
                            <div class="detail-cover">
                                <span class="cover-fallback">◈</span>
                                @if(!string.IsNullOrEmpty(Ui.Str(st,"cover_url")))
                                {
                                    <img src="@Ui.Str(st,"cover_url")" alt="@Ui.Str(st,"title")" />
                                }
                            </div>
                            <div class="detail-intro">
                                <span class="eyebrow">@Ui.Str(st,"genres")</span>
                                <h1>@Ui.Str(st,"title")</h1>
                                <p class="detail-author"><b>Tác giả:</b> @Ui.Str(st,"author")</p>
                                <p class="detail-episode-count">@episodes.Length tập · @(isPremium || isAdmin ? "Nghe trọn vẹn" : "Nghe thử 5 phút mỗi tập")</p>
                                <div class="story-trends"><span>◉ @Ui.Num(st,"listenerCount") người nghe hợp lệ</span><span>★ @Ui.Str(st,"ratingAverage") / 5 (@Ui.Num(st,"ratingCount") đánh giá)</span></div>
                                @if(!string.IsNullOrWhiteSpace(Ui.Str(st,"description")))
                                {
                                    <p class="story-description-preview">@Ui.Str(st,"description")</p>
                                    <button type="button" class="detail-readmore" aria-expanded="@showFullDescription" @onclick="ToggleStoryDescription">
                                        @(showFullDescription ? "Thu gọn mô tả" : "Xem chi tiết nội dung")
                                        <AppIcon Name="arrow-right" Size="15" />
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="detail-actionbar">
                            @if(episodes.Length > 0)
                            {
                                <button class="btn btn-primary" @onclick="() => Play(episodes[0])"><AppIcon Name="play" Size="17" /> Nghe tập đầu tiên</button>
                            }
                            @if(!isPremium && !isAdmin)
                            {
                                <a class="btn btn-outline" href="/premium"><AppIcon Name="crown" Size="17" /> Nâng cấp Premium</a>
                            }
                        </div>
                    </div>
                    @if(showFullDescription && !string.IsNullOrWhiteSpace(Ui.Str(st,"description")))
                    {
                        <section class="story-full-description" aria-label="Nội dung giới thiệu đầy đủ">
                            <div class="story-full-description-heading">
                                <h2>Giới thiệu truyện</h2>
                                <button type="button" class="detail-readmore" @onclick="ToggleStoryDescription">Thu gọn <AppIcon Name="arrow-right" Size="15" /></button>
                            </div>
                            <p>@Ui.Str(st,"description")</p>
                        </section>
                    }
                    <section class="section"><div class="section-heading flex flex-wrap items-end justify-between gap-4"><div><small>PLAYLIST</small><h2>Danh sách tập</h2></div><span class="pill">@episodes.Length tập</span></div><div class="episode-list">@foreach(var episode in episodes){<button class="episode" @onclick="() => Play(episode)"><span class="episode-no">@Ui.Num(episode,"episode_number").ToString("00")</span><span class="episode-name"><b>@Ui.Str(episode,"title")</b><small>@Ui.Duration(Ui.Num(episode,"duration_seconds")) · @(isPremium || isAdmin ? "Toàn tập" : "Preview 05:00")</small></span><span class="play-circle"><AppIcon Name="play" Size="18" /></span></button>}</div></section>
                    <section class="section story-reviews"><div class="section-heading"><div><small>THẢO LUẬN</small><h2>Đánh giá bộ truyện</h2><p>★ @Ui.Str(st,"ratingAverage") / 5 · @Ui.Num(st,"ratingCount") lượt đánh giá</p></div></div>
                        @if(isAuthenticated)
                        {
                            <div class="panel form review-form"><h3>Đánh giá của bạn</h3>
                                @if(myReviewHidden)
                                {
                                    <div class="review-hidden-notice" role="status">⚠ Đánh giá của bạn hiện đang được Quản trị viên tạm ẩn và không hiển thị công khai.</div>
                                }
                                <div class="rating-choices" role="group" aria-label="Chọn điểm đánh giá">
                                @for(var score=1;score<=5;score++){var stars=score;<button class="rating-choice @(myReviewStars>=score?"chosen":"")" title="@($"{score} sao")" @onclick="() => myReviewStars=stars">★</button>}
                            </div><label>Nội dung đánh giá<textarea @bind="myReviewBody" maxlength="1200" rows="3" placeholder="Cảm nhận của bạn về bộ truyện..."></textarea></label>
                            <div class="table-actions"><button class="btn btn-primary" disabled="@busy" @onclick="SaveReview">Lưu đánh giá</button>
                                @if(hasOwnReview){<button class="btn btn-outline" disabled="@busy" @onclick="DeleteReview">Xóa đánh giá</button>}
                            </div></div>
                        }
                        else {<div class="empty">Đăng nhập để đánh giá và bình luận về bộ truyện.</div>}
                        <div class="review-list">@foreach(var r in reviews){<article class="review-item"><div class="review-top"><b>@Ui.Str(r,"username")</b><span class="rating-stars">@(new string('★',Ui.Num(r,"stars")))</span><small>@Ui.Date(Ui.Str(r,"updated_at"))</small></div>
                            <p>@Ui.Str(r,"body")</p></article>}</div>
                        @if(reviews.Length==0){<div class="empty">Chưa có đánh giá nào. Hãy là người đầu tiên!</div>}
                    </section>
                } else {<div class="empty">Không tìm thấy truyện hoặc truyện chưa được phát hành.</div>}
            }
            else if (page == "history")
            {
