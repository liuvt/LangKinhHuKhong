@code {
    [Parameter] public string? Slug { get; set; }
    [Parameter] public string? GenreSlug { get; set; }
    private string page="home", loadedRoute="__initial_route_pending__", prerenderedRoute="", search="", genre="", sortMode="updated", authMode="", username="", password="", registerName="",registerPhone="",registerAddress="",authError="",message="";
    private readonly SemaphoreSlim routeGate = new(1, 1);
    private bool loading=true,busy=false,messageIsError=false,mobileMenuOpen=false,showFullDescription=false,catalogLoaded=false,sessionChecked=false;
    private JsonElement user,detail,playing,orderDetail;
    private JsonElement[] stories=[],updatedStories=[],newestStories=[],popularStories=[],genreCatalog=[],reviews=[],history=[],episodes=[],orders=[];
    // Giữ playlist của bộ truyện đang nghe ngay cả khi người dùng đổi trang.
    private JsonElement[] playbackQueue=[];
    private bool autoNextEnabled=true;
    private DotNetObjectReference<Home>? playerCallback;
    private string myReviewBody="";
    private int myReviewStars=5;
    private bool hasOwnReview=false,myReviewHidden=false;
    private string profileName="",profilePhone="",profileAddress="",activePlayerId="";
    private string currentPassword="", newPassword="", confirmPassword="";
    private int planPrice=100000,planMonths=1;
    private string CurrentUserId => Ui.Str(user, "id");
    private string GenreName
    {
        get
        {
            var found = genreCatalog.FirstOrDefault(g => Ui.Str(g, "slug") == genre);
            var name = Ui.Str(found, "name");
            return string.IsNullOrWhiteSpace(name) ? "theo thể loại" : name;
        }
    }
    private bool isAuthenticated => Ui.Property(user,"id").ValueKind==JsonValueKind.String;
    private bool isPremium => Ui.Bool(user,"isPremium");
    private bool isAdmin => Ui.Str(user,"role")=="Admin";
    private string NavigationHeading => page switch
    {
        "home" => "Trang chủ", "library" => "Thư viện truyện",
        "history" => "Lịch sử xem & nghe", "story" => "Chi tiết bộ truyện",
        "premium" => "Gói Premium", "account" => "Hồ sơ cá nhân",
        "admin" => "Quản trị hệ thống", _ => "Lăng Kính Hư Không"
    };
    private string PlayerId => Ui.Str(playing,"id");
    private string PlayerSource => "/api/episodes/" + Uri.EscapeDataString(PlayerId) +
        (isPremium || isAdmin ? "/hls/index.m3u8" : "/stream");
    private static string StoryUrl(JsonElement story) => "/truyen/" + Uri.EscapeDataString(Ui.Str(story,"slug"));
    // A single Razor component handles several @page routes. OnParametersSet by itself
    // does not reliably synchronize state when the same component instance is reused.
    // Listen for URL changes explicitly, and let NavLink independently track active items.
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        UpdatePageFromUrl();
    }
    protected override void OnParametersSet() => UpdatePageFromUrl();

    private async Task ResolveServerSessionAsync(SqliteConnection db)
    {
        ClaimsPrincipal? principal = HttpContextAccessor.HttpContext?.User;
        if (principal?.Identity?.IsAuthenticated != true)
        {
            try
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                principal = authState.User;
            }
            catch { principal = null; }
        }
        if (principal?.Identity?.IsAuthenticated == true)
        {
            var uid = Helpers.UserId(principal);
            if (!string.IsNullOrEmpty(uid))
            {
                var u = await db.FirstAsync("SELECT * FROM users WHERE id=@id", ("@id", uid));
                var pver = principal.FindFirst("pver")?.Value;
                var stamp = u is not null ? Helpers.PasswordStamp(u.S("password_hash")) : "";
                if (u is not null && u.S("status") == "Active" && (pver is null || pver == stamp))
                {
                    user = JsonSerializer.SerializeToElement(Helpers.SafeUser(u, await Helpers.PremiumUntil(db, uid)));
                    profileName = Ui.Str(user, "fullName");
                    profilePhone = Ui.Str(user, "phone");
                    profileAddress = Ui.Str(user, "address");
                    sessionChecked = true;
                    return;
                }
            }
        }
        user = default;
        sessionChecked = true;
    }

    private async Task LoadCatalogFromDbAsync(SqliteConnection db)
    {
        var published = await db.ListAsync(@"
            WITH ep_counts AS (
                SELECT story_id, COUNT(*) AS cnt FROM episodes WHERE status='Published' GROUP BY story_id
            ),
            latest_ep AS (
                SELECT e.story_id,
                       e.episode_number AS latest_ep_num,
                       e.title AS latest_ep_title,
                       e.created_at AS latest_ep_at
                FROM episodes e
                WHERE e.status='Published'
                  AND e.id = (
                      SELECT e2.id FROM episodes e2
                      WHERE e2.story_id = e.story_id AND e2.status='Published'
                      ORDER BY e2.created_at DESC, e2.episode_number DESC LIMIT 1
                  )
            ),
            listener_counts AS (
                SELECT story_id, COUNT(*) AS cnt FROM story_listeners WHERE qualified_at IS NOT NULL GROUP BY story_id
            ),
            total_listeners AS (
                SELECT story_id, COUNT(DISTINCT user_id) AS cnt FROM (
                    SELECT sl.story_id, sl.user_id FROM story_listeners sl
                    UNION
                    SELECT ep.story_id, lp.user_id FROM listening_progress lp JOIN episodes ep ON ep.id = lp.episode_id
                ) GROUP BY story_id
            ),
            review_stats AS (
                SELECT story_id, COUNT(*) AS cnt, ROUND(AVG(stars),1) AS avg_stars FROM story_reviews WHERE status='Visible' GROUP BY story_id
            ),
            genre_list AS (
                SELECT sg.story_id, group_concat(g.name,' | ') AS names
                FROM story_genres sg JOIN genres g ON g.slug=sg.genre_slug GROUP BY sg.story_id
            )
            SELECT s.id,s.slug,s.title,s.author,s.genre,s.description,s.created_at,s.updated_at,
            CASE WHEN s.cover_file<>'' THEN '/api/stories/' || s.id || '/cover' ELSE s.cover_url END AS cover_url,s.status,
            COALESCE(gl.names,'') AS genres,
            COALESCE(ec.cnt,0) AS episodeCount,
            COALESCE(le.latest_ep_num,0) AS latestEpisodeNumber,
            COALESCE(le.latest_ep_title,'') AS latestEpisodeTitle,
            COALESCE(le.latest_ep_at, s.updated_at, s.created_at) AS latestEpisodeAt,
            COALESCE(lc.cnt,0) AS listenerCount,
            COALESCE(tl.cnt,0) AS activeListenerCount,
            COALESCE(rs.cnt,0) AS ratingCount,
            COALESCE(rs.avg_stars,0) AS ratingAverage
            FROM stories s
            LEFT JOIN genre_list gl ON gl.story_id=s.id
            LEFT JOIN ep_counts ec ON ec.story_id=s.id
            LEFT JOIN latest_ep le ON le.story_id=s.id
            LEFT JOIN listener_counts lc ON lc.story_id=s.id
            LEFT JOIN total_listeners tl ON tl.story_id=s.id
            LEFT JOIN review_stats rs ON rs.story_id=s.id
            WHERE s.status='Published' ORDER BY s.created_at DESC LIMIT 200");
        newestStories = published.Select(x => JsonSerializer.SerializeToElement(x)).ToArray();
        var withEpisodes = published.Where(x => x.N("episodeCount") > 0).ToList();
        updatedStories = (withEpisodes.Count > 0 ? withEpisodes : published)
            .OrderByDescending(x => x.S("latestEpisodeAt"))
            .ThenByDescending(x => x.S("updated_at"))
            .Select(x => JsonSerializer.SerializeToElement(x)).ToArray();
        popularStories = published
            .OrderByDescending(x => x.N("listenerCount"))
            .ThenByDescending(x => x.N("activeListenerCount"))
            .ThenByDescending(x => double.TryParse(x.S("ratingAverage"), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var r) ? r : 0)
            .ThenByDescending(x => x.N("episodeCount"))
            .ThenByDescending(x => x.S("latestEpisodeAt"))
            .Select(x => JsonSerializer.SerializeToElement(x)).ToArray();
        stories = newestStories;
        genreCatalog = (await db.ListAsync("SELECT slug,name FROM genres WHERE is_active=1 ORDER BY sort_order,name"))
            .Select(x => JsonSerializer.SerializeToElement(x)).ToArray();
        catalogLoaded = true;
    }

    private async Task LoadListeningFromDbAsync(SqliteConnection db)
    {
        if (!isAuthenticated || string.IsNullOrEmpty(CurrentUserId)) { history = []; return; }
        var rows = await db.ListAsync(@"
            WITH latest_lp AS (
                SELECT e.story_id, p.episode_id, p.seconds, p.updated_at, e.title AS episode_title, e.episode_number
                FROM listening_progress p
                JOIN episodes e ON e.id = p.episode_id
                WHERE p.user_id = @u
                  AND p.episode_id = (
                      SELECT p2.episode_id FROM listening_progress p2
                      JOIN episodes e2 ON e2.id = p2.episode_id
                      WHERE p2.user_id = @u AND e2.story_id = e.story_id
                      ORDER BY p2.updated_at DESC LIMIT 1
                  )
            ),
            story_activity AS (
                SELECT story_id, MAX(at) AS activity_at FROM (
                    SELECT story_id, updated_at AS at FROM latest_lp
                    UNION ALL
                    SELECT story_id, viewed_at AS at FROM user_story_views WHERE user_id = @u
                ) GROUP BY story_id
            )
            SELECT COALESCE(lp.episode_id, '') AS episode_id,
                   COALESCE(lp.seconds, 0) AS seconds,
                   sa.activity_at AS updated_at,
                   COALESCE(lp.episode_title, '') AS episode_title,
                   COALESCE(lp.episode_number, 0) AS episode_number,
                   s.title AS story_title,
                   s.slug,
                   CASE WHEN s.cover_file<>'' THEN '/api/stories/' || s.id || '/cover' ELSE s.cover_url END AS cover_url
            FROM story_activity sa
            JOIN stories s ON s.id = sa.story_id AND s.status = 'Published'
            LEFT JOIN latest_lp lp ON lp.story_id = sa.story_id
            ORDER BY sa.activity_at DESC LIMIT 30", ("@u", CurrentUserId));
        history = rows.Select(x => JsonSerializer.SerializeToElement(x)).ToArray();
    }

    private async Task LoadStoryAndReviewsFromDbAsync(SqliteConnection db, string slug)
    {
        var selected = await db.FirstAsync(@"SELECT s.id,s.slug,s.title,s.author,s.description,s.genre,s.created_at,s.updated_at,
            CASE WHEN s.cover_file<>'' THEN '/api/stories/' || s.id || '/cover' ELSE s.cover_url END AS cover_url,s.status,
            COALESCE((SELECT group_concat(g.name,' | ') FROM story_genres sg JOIN genres g ON g.slug=sg.genre_slug
                WHERE sg.story_id=s.id),'') AS genres,
            (SELECT COUNT(*) FROM story_listeners l WHERE l.story_id=s.id AND l.qualified_at IS NOT NULL) AS listenerCount,
            (SELECT COUNT(*) FROM story_reviews r WHERE r.story_id=s.id AND r.status='Visible') AS ratingCount,
            COALESCE((SELECT ROUND(AVG(r.stars),1) FROM story_reviews r WHERE r.story_id=s.id AND r.status='Visible'),0) AS ratingAverage
            FROM stories s WHERE s.slug=@slug AND s.status='Published'", ("@slug", slug));
        if (selected is not null)
        {
            var storyId = selected.S("id");
            if (isAuthenticated && !string.IsNullOrEmpty(CurrentUserId))
            {
                await db.ExecAsync(@"INSERT INTO user_story_views(user_id,story_id,viewed_at) VALUES(@u,@s,@now)
                    ON CONFLICT(user_id,story_id) DO UPDATE SET viewed_at=excluded.viewed_at",
                    ("@u", CurrentUserId), ("@s", storyId), ("@now", Helpers.Now()));
                await LoadListeningFromDbAsync(db);
            }
            var list = await db.ListAsync("SELECT id,title,episode_number,duration_seconds,created_at FROM episodes WHERE story_id=@id AND status='Published' ORDER BY episode_number", ("@id", storyId));
            detail = JsonSerializer.SerializeToElement(new { story = selected, episodes = list });
            episodes = Ui.Array(Ui.Property(detail, "episodes"));
            await LoadReviewsByStoryIdFromDbAsync(db, storyId);
        }
        else
        {
            detail = default;
            episodes = [];
            reviews = [];
            hasOwnReview = false;
            myReviewHidden = false;
        }
    }

    private async Task LoadReviewsByStoryIdFromDbAsync(SqliteConnection db, string storyId)
    {
        var uid = isAuthenticated ? CurrentUserId : "";
        var rows = await db.ListAsync(@"SELECT r.id,r.stars,r.body,r.status,r.updated_at,u.username,
            CASE WHEN r.user_id=@user THEN 1 ELSE 0 END AS is_mine
            FROM story_reviews r JOIN users u ON u.id=r.user_id
            WHERE r.story_id=@story AND (r.status='Visible' OR (@user<>'' AND r.user_id=@user)) AND u.status='Active'
            ORDER BY r.updated_at DESC LIMIT 100", ("@user", uid), ("@story", storyId));
        var allReviews = rows.Select(x => JsonSerializer.SerializeToElement(x)).ToArray();
        var mine = allReviews.FirstOrDefault(r => Ui.Num(r, "is_mine") == 1);
        hasOwnReview = mine.ValueKind == JsonValueKind.Object;
        myReviewHidden = hasOwnReview && Ui.Str(mine, "status") == "Hidden";
        if (hasOwnReview) { myReviewStars = Ui.Num(mine, "stars"); myReviewBody = Ui.Str(mine, "body"); }
        reviews = allReviews.Where(r => Ui.Str(r, "status") != "Hidden").ToArray();
    }

    private async Task LoadPremiumFromDbAsync(SqliteConnection db)
    {
        var plan = await db.FirstAsync("SELECT id,code,name,price_vnd,duration_months FROM subscription_plans WHERE code='PREMIUM' LIMIT 1");
        if (plan is not null) { planPrice = plan.N("price_vnd"); planMonths = plan.N("duration_months"); }
        if (isAuthenticated && !string.IsNullOrEmpty(CurrentUserId))
        {
            await db.ExecAsync("UPDATE orders SET status='Expired' WHERE order_type='Purchase' AND status='Pending' AND expires_at<=@now", ("@now", Helpers.Now()));
            var rows = await db.ListAsync(@"SELECT o.id,o.code,o.amount_vnd,o.duration_months,o.status,o.order_type,o.grant_reason,
                o.created_at,o.expires_at,o.paid_at,
                COALESCE(o.premium_start_at,(SELECT starts_at FROM subscriptions WHERE order_id=o.id LIMIT 1)) AS premium_start_at,
                COALESCE(o.premium_end_at,(SELECT ends_at FROM subscriptions WHERE order_id=o.id LIMIT 1)) AS premium_end_at,
                COALESCE(admin.username,'') AS granted_by_name
                FROM orders o LEFT JOIN users admin ON admin.id=o.reviewed_by
                WHERE o.user_id=@u ORDER BY o.created_at DESC LIMIT 100", ("@u", CurrentUserId));
            orders = rows.Select(x => JsonSerializer.SerializeToElement(x)).ToArray();
        }
        else
        {
            orders = [];
        }
    }

    // Prerender and initialize the user session + public catalog/route directly from SQLite on the server
    // so logged-in users and crawlers see the complete page immediately without waiting for JS round-trips.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await Database.OpenAsync();
            await ResolveServerSessionAsync(db);
            await LoadCatalogFromDbAsync(db);
            if (isAuthenticated)
            {
                await LoadListeningFromDbAsync(db);
            }
            if (page == "story")
            {
                var route = CurrentRoute();
                if (route.StartsWith("truyen/", StringComparison.OrdinalIgnoreCase))
                {
                    var slug = Uri.UnescapeDataString(route["truyen/".Length..]);
                    await LoadStoryAndReviewsFromDbAsync(db, slug);
                }
            }
            else if (page == "premium")
            {
                await LoadPremiumFromDbAsync(db);
            }
            prerenderedRoute = CurrentRoute();
            loading = false;
        }
        catch
        {
            // Runtime API loading still works if optional SSR preloading fails.
        }
    }

    private string CurrentRoute()
        => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');

    private void UpdatePageFromUrl()
    {
        var route = CurrentRoute();
        mobileMenuOpen = false;
        page = route switch
        {
            "" => "home", "thu-vien" => "library", "lich-su" => "history",
            "tai-khoan" => "account", "premium" => "premium", "quan-tri" => "admin",
            _ when route.StartsWith("truyen/", StringComparison.OrdinalIgnoreCase) => "story",
            _ when route.StartsWith("the-loai/", StringComparison.OrdinalIgnoreCase) => "library",
            _ => "home"
        };
        genre = route.StartsWith("the-loai/", StringComparison.OrdinalIgnoreCase)
            ? Uri.UnescapeDataString(route["the-loai/".Length..])
            : "";
        if (page == "library")
        {
            try
            {
                var qIdx = Navigation.Uri.IndexOf('?');
                if (qIdx >= 0)
                {
                    var query = Navigation.Uri[(qIdx + 1)..].Split('#')[0];
                    foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
                    {
                        var kv = part.Split('=', 2);
                        if (kv.Length == 2 && kv[0].Equals("sort", StringComparison.OrdinalIgnoreCase))
                        {
                            var val = Uri.UnescapeDataString(kv[1]).ToLowerInvariant();
                            if (val is "updated" or "new" or "popular") sortMode = val;
                        }
                    }
                }
            }
            catch { }
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        // Dispatch on the Blazor renderer synchronization context.
        _ = InvokeAsync(LoadRouteIfChangedAsync);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // First interactive render, browser refresh, or a missed route update.
        if (loadedRoute != CurrentRoute())
            await LoadRouteIfChangedAsync();

        if (firstRender)
        {
            playerCallback = DotNetObjectReference.Create(this);
            try { await Api.BindAutoNext(playerCallback); } catch { }
        }

        var id = Ui.Str(playing, "id");
        if (id != "" && activePlayerId != id)
        {
            activePlayerId = id;
            await Api.Listen(id);
        }
        if (id == "") activePlayerId = "";
    }

    private async Task LoadRouteIfChangedAsync()
    {
        // Serialize navigations so a slow response from an old route does not
        // overwrite the data for the page opened after it.
        await routeGate.WaitAsync();
        try
        {
            var route = CurrentRoute();
            UpdatePageFromUrl();
            if (loadedRoute == route) { StateHasChanged(); return; }
            loadedRoute = route;

            // If server initialization already loaded the exact route & session, do not wipe UI or re-query!
            if (prerenderedRoute == route && catalogLoaded && sessionChecked)
            {
                prerenderedRoute = "";
                loading = false;
                StateHasChanged();
                return;
            }
            prerenderedRoute = "";

            detail = default;
            reviews=[]; hasOwnReview=false; myReviewHidden=false; myReviewBody=""; myReviewStars=5;
            showFullDescription = false;
            episodes = [];
            orderDetail = default;
            var needsBlockingLoader = !catalogLoaded || page is "story" or "premium";
            if (needsBlockingLoader)
            {
                loading = true;
                StateHasChanged();
            }
            await LoadPage();
            StateHasChanged();
        }
        finally { routeGate.Release(); }
    }

    private async Task EnsureAuthLoadedAsync(bool force = false)
    {
        if (sessionChecked && !force) return;
        try
        {
            await using var db = await Database.OpenAsync();
            await ResolveServerSessionAsync(db);
            if (isAuthenticated || !force) return;
        }
        catch { }
        try { user = await Api.Get("/auth/me"); }
        catch { user = default; }
        sessionChecked = true;
    }

    private async Task EnsureCatalogLoadedAsync(bool force = false)
    {
        if (catalogLoaded && !force && newestStories.Length > 0 && genreCatalog.Length > 0) return;
        await using var db = await Database.OpenAsync();
        await LoadCatalogFromDbAsync(db);
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        try { await Api.BindAutoNext(null); }
        catch (JSDisconnectedException) { /* Browser disconnected. */ }
        catch (InvalidOperationException) { /* Interactive render no longer available. */ }
        finally { playerCallback?.Dispose(); }
    }

    private async Task LoadPage()
    {
        try
        {
            await using var db = await Database.OpenAsync();
            if (!sessionChecked) await ResolveServerSessionAsync(db);
            if (!catalogLoaded || newestStories.Length == 0 || genreCatalog.Length == 0)
                await LoadCatalogFromDbAsync(db);

            if (isAuthenticated && (page is "home" or "history" || history.Length == 0))
            {
                await LoadListeningFromDbAsync(db);
            }
            else if (!isAuthenticated)
            {
                history = [];
            }

            if (page == "story" && CurrentRoute().StartsWith("truyen/", StringComparison.OrdinalIgnoreCase))
                await LoadStoryAndReviewsFromDbAsync(db, Uri.UnescapeDataString(CurrentRoute()["truyen/".Length..]));
            if (page == "premium")
                await LoadPremiumFromDbAsync(db);
            if (page == "account")
            {
                profileName = Ui.Str(user, "fullName");
                profilePhone = Ui.Str(user, "phone");
                profileAddress = Ui.Str(user, "address");
            }
        }
        catch(Exception e){Notice(e.Message,true);}
        finally{loading=false;}
    }

    private async Task LoadListeningSafeAsync()
    {
        try
        {
            await using var db = await Database.OpenAsync();
            await LoadListeningFromDbAsync(db);
        }
        catch { history = []; }
    }
