    // Called only when a real HTMLAudioElement 'ended' event fires; never on pause/error.
    [JSInvokable]
    public Task OnAudioEnded(string finishedEpisodeId) => InvokeAsync(() =>
    {
        if (!autoNextEnabled || !isAuthenticated ||
            !string.Equals(PlayerId, finishedEpisodeId, StringComparison.Ordinal)) return;

        var currentIndex = Array.FindIndex(playbackQueue,
            ep => string.Equals(Ui.Str(ep, "id"), finishedEpisodeId, StringComparison.Ordinal));
        if (currentIndex < 0) return;

        // API /stories/{slug} returns only published episodes, ordered by episode_number.
        // Do not wrap around to the beginning when the last published episode finishes.
        for (var i = currentIndex + 1; i < playbackQueue.Length; i++)
        {
            if (string.IsNullOrWhiteSpace(Ui.Str(playbackQueue[i], "id"))) continue;
            playing = playbackQueue[i];
            activePlayerId = "";
            StateHasChanged();
            return;
        }
    });

    private async Task ClosePlayer(){ playing=default; activePlayerId=""; await Api.StopAudio(); }
    private void Play(JsonElement ep)
    {
        if (!isAuthenticated) { authMode="login"; return; }
        // Copy the current story playlist before the route data can be replaced.
        playbackQueue=episodes.ToArray();
        playing=ep;
        activePlayerId="";
    }
    private void OpenHistory(JsonElement item) => Navigation.NavigateTo("/truyen/"+Uri.EscapeDataString(Ui.Str(item,"slug")));
